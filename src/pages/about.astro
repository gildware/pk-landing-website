---
import PageLayout from '@/layouts/PageLayout.astro';
import CategoryMarquee from '@/components/CategoryMarquee.astro';
import Icon from '@/components/Icon.astro';
import { buildMeta } from '@/utils/seo';
import { getSiteSettings, getServices } from '@/utils/reader';
import { BOOK_PATH, PARTNER_PATH, whatsappHref } from '@/utils/booking';

const site = await getSiteSettings();
const services = await getServices();
const customerWhatsAppHref = whatsappHref(
  site.whatsapp,
  'Hello Panun Kaergar, I would like to book a home service.',
);

const categories = services.map((s) => ({
  slug: s.slug,
  shortName: s.shortName,
}));

const storyImages = [
  {
    src: '/images/about/about-hero-main.webp',
    alt: 'Panun Kaergar professional arriving at a Kashmiri home doorway',
  },
  {
    src: '/images/about/about-hero-garden.webp',
    alt: 'Garden care service for homes in Kashmir',
  },
  {
    src: '/images/about/about-hero-home.webp',
    alt: 'Everyday home cleaning and care services',
  },
  {
    src: '/images/about/about-hero-vehicle.webp',
    alt: 'Vehicle care service outside a Kashmiri home',
  },
];

const whoWeAre = [
  {
    icon: 'home',
    title: 'One company for your home',
    description:
      'Repairs, cleaning, salon, appliances, and more — you hire Panun Kaergar, not a list of private numbers.',
  },
  {
    icon: 'headset',
    title: 'We manage the experience',
    description:
      'Booking, pricing, coordination, payment, quality, and support stay with us from the first request to a finished visit.',
  },
  {
    icon: 'wrench',
    title: 'Teams and partners fulfill the work',
    description:
      'Our own teams, commission-based vendors, and specialist partners perform the visit to Panun Kaergar standards.',
  },
  {
    icon: 'sparkles',
    title: 'Built for Kashmir',
    description:
      'Local craftsmanship and everyday modern needs, booked the same way — for Srinagar and communities across Kashmir.',
  },
  {
    icon: 'wallet',
    title: 'Price before work starts',
    description:
      'Panun Kaergar sets the customer-facing price. You know the expected cost before tools come out.',
  },
  {
    icon: 'shield-check',
    title: 'You come back to us',
    description:
      'If a visit goes wrong, you contact Panun Kaergar — not a technician’s private number.',
  },
];

const forCustomers = [
  { icon: 'calendar', label: 'Booking and scheduling' },
  { icon: 'wallet', label: 'Customer pricing' },
  { icon: 'map-pin', label: 'Job coordination' },
  { icon: 'user', label: 'Team or partner allocation' },
  { icon: 'check-circle', label: 'Payment collection' },
  { icon: 'headset', label: 'Quality and support' },
  { icon: 'phone', label: 'One company to call' },
  { icon: 'shield-check', label: 'You come back to us if it fails' },
];

const forPartners = [
  { icon: 'inbox', label: 'We bring the customer' },
  { icon: 'calendar', label: 'We handle booking and pricing' },
  { icon: 'map-pin', label: 'We coordinate the job' },
  { icon: 'wallet', label: 'We settle partner payout' },
  { icon: 'hammer', label: 'You bring the skill and tools' },
  { icon: 'wrench', label: 'You fulfill the visit' },
  { icon: 'user', label: 'Independent partner, not an employee' },
  { icon: 'shield-check', label: 'You follow our service standards' },
];

const missionPoints = [
  'Households in Kashmir get professional help without hunting numbers or hoping a callback comes.',
  'You hire one company that owns booking, pricing, coordination, payment, quality, and support.',
  'The visit is fulfilled by our own teams, commission-based vendors, or specialist partners.',
  'Local skilled people do the work as independent partners — not as employees on a salary.',
  'Kashmir craft — carpentry, masonry, finishing — stays in the work, booked the same way as a modern repair.',
];

const visionPoints = [
  'Become Kashmir’s most trusted home-services company — the name households call first.',
  'Make it simple to get work done at home: phone, WhatsApp, website, or app.',
  'Keep traditional skills visible and bookable for the next generation of customers.',
  'Cover the whole house: trades, cleaning, salon, appliances, garden, and vehicle care.',
  'Stay the company responsible for the outcome — not a directory of private contacts.',
];

const bridgePoints = [
  {
    title: 'Traditional craftsmanship',
    description:
      'Local skills — carpentry, masonry, finishing — stay visible and bookable for the next generation of customers.',
  },
  {
    title: 'Everyday modern needs',
    description:
      'Appliance repair, cleaning, salon, pest control, vehicle help, and more — services that keep Kashmiri homes running.',
  },
  {
    title: 'One company for your home',
    description:
      'You describe the job once. Panun Kaergar handles pricing, who does the work, payment, and follow-up.',
  },
];

const meta = buildMeta({
  title: 'About Panun Kaergar | Home Services in Srinagar',
  description:
    'Panun Kaergar is Kashmir’s full-stack home-services company. You tell us what needs to be done — we handle booking, pricing, coordination, payment, quality, and support. Our teams or professional partners do the work.',
  path: '/about',
});
---

<PageLayout meta={meta}>
  <!-- Hero: match partner page layout -->
  <section
    class="relative overflow-hidden bg-brand-900 bg-gradient-to-br from-brand-900 via-brand-600 to-brand-700 text-white"
    style="background-color: #121228; color: #ffffff;"
  >
    <div class="hero-blob -left-24 top-0 h-72 w-72 bg-brand-500/30" style="animation-delay: 0s;" aria-hidden="true"></div>
    <div class="hero-blob -right-16 bottom-0 h-96 w-96 bg-accent/20" style="animation-delay: -5s;" aria-hidden="true"></div>
    <div class="hero-blob left-1/3 top-1/2 h-48 w-48 bg-white/10" style="animation-delay: -9s;" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-9 lg:py-14">
      <div class="flex flex-col gap-5 lg:grid lg:grid-cols-2 lg:items-start lg:gap-12">
        <h1
          class="animate-fade-up text-xl font-extrabold leading-snug text-white sm:text-2xl lg:col-start-1 lg:row-start-1 lg:text-[2.85rem] lg:leading-[1.1]"
          style="color: #ffffff;"
        >
          Your Home. Our Responsibility.
        </h1>

        <div class="animate-slide-right stagger-2 lg:col-start-2 lg:row-start-1 lg:row-span-2">
          <div class="about-hero-mosaic" aria-hidden="true">
            {
              storyImages.map((img, i) => (
                <figure class:list={['about-hero-mosaic__cell', `about-hero-mosaic__cell--${i + 1}`]}>
                  <img
                    src={img.src}
                    alt={img.alt}
                    width="768"
                    height="512"
                    class="h-full w-full object-cover"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </figure>
              ))
            }
          </div>
          <p class="sr-only">
            Panun Kaergar is Kashmir’s full-stack home-services company. You book with us; we manage
            the entire experience; our own team or a professional partner does the work.
          </p>
        </div>

        <div class="lg:col-start-1 lg:row-start-2">
          <p class="animate-fade-up stagger-1 inline-flex max-w-full items-center rounded-full border border-white/25 bg-white/10 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-white/90 backdrop-blur-sm">
            Kashmir’s full-stack home-services company
          </p>
          <p class="animate-fade-up stagger-2 mt-3 max-w-xl text-base leading-relaxed text-white/85 sm:text-lg">
            You tell us what needs to be done. We handle booking, pricing, coordination, payment,
            quality, and support. Our own teams or professional partners perform the work.
          </p>

          <ul class="animate-fade-up stagger-3 mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/80 sm:mt-6 sm:gap-x-6 sm:gap-y-3">
            <li class="flex items-center gap-2">
              <Icon name="check" size={17} class="text-white" />
              One company for your home
            </li>
            <li class="flex items-center gap-2">
              <Icon name="check" size={17} class="text-white" />
              We manage the experience
            </li>
            <li class="flex items-center gap-2">
              <Icon name="check" size={17} class="text-white" />
              Teams and partners fulfill the work
            </li>
          </ul>

          <div class="animate-fade-up stagger-4 mt-6 flex flex-wrap gap-3">
            <a href={BOOK_PATH} class="btn-primary bg-white text-brand-700 hover:bg-brand-50">
              Book a service
            </a>
            <a
              href={PARTNER_PATH}
              class="inline-flex items-center gap-2 rounded-xl border-2 border-white/40 px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 ease-smooth hover:-translate-y-0.5 hover:border-white/60 hover:bg-white/10"
            >
              Join as a partner
            </a>
          </div>

          <div class="animate-fade-up stagger-5 mt-4 flex flex-wrap gap-3">
            <a
              href={`tel:${site.phone}`}
              class="inline-flex items-center gap-2 rounded-xl border-2 border-white/40 px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 ease-smooth hover:-translate-y-0.5 hover:border-white/60 hover:bg-white/10"
            >
              <Icon name="phone" size={18} />
              Call {site.phone}
            </a>
            <a
              href={customerWhatsAppHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl border-2 border-emerald-300/50 px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 ease-smooth hover:-translate-y-0.5 hover:border-emerald-300/80 hover:bg-emerald-400/15"
            >
              <Icon name="whatsapp" size={18} />
              WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CategoryMarquee categories={categories} />

  <!-- Who we are -->
  <section class="border-y border-slate-200 bg-white">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-extrabold text-slate-900">Who we are</h2>
        <p class="mt-3 text-lg text-slate-600">
          Not a directory. Not a lead marketplace. A home-services company that stays responsible
          for the job.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          whoWeAre.map((item, i) => (
            <article
              class:list={[
                'reveal-scale card card-hover p-5 sm:p-6',
                `reveal-stagger-${Math.min(i + 1, 6)}`,
              ]}
            >
              <span class="icon-badge">
                <Icon name={item.icon} size={22} class="text-brand-600" />
              </span>
              <h3 class="mt-4 text-base font-bold leading-snug text-slate-900">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Mission & vision -->
  <section class="bg-slate-50" aria-labelledby="mission-vision-heading">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="reveal max-w-3xl">
        <h2 id="mission-vision-heading" class="text-3xl font-extrabold text-slate-900 sm:text-4xl">
          Mission and vision
        </h2>
        <p class="mt-3 text-lg text-slate-600">
          Why Panun Kaergar exists, and where we are taking home services in Kashmir.
        </p>
      </div>

      <div class="reveal mt-10 overflow-hidden rounded-[1.75rem] shadow-xl">
        <div class="grid items-stretch lg:grid-cols-2">
          <article class="flex flex-col bg-brand-900 p-6 text-white sm:p-8 lg:p-10">
            <p class="inline-flex w-fit rounded-full bg-white/10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white/80">
              Mission
            </p>
            <h3 class="mt-4 text-2xl font-extrabold leading-tight sm:text-3xl">
              Why Panun Kaergar exists
            </h3>
            <p class="mt-4 text-base leading-relaxed text-white/75">
              Help every household in Kashmir get professional service with a clear price and a
              company that stays responsible — while local skilled people do the work.
            </p>
            <ul class="mt-6 space-y-3">
              {
                missionPoints.map((point) => (
                  <li class="flex items-start gap-3 text-sm leading-relaxed text-white/85">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-white text-brand-900">
                      <Icon name="check" size={12} class="text-brand-900" />
                    </span>
                    <span>{point}</span>
                  </li>
                ))
              }
            </ul>
          </article>
          <article class="flex flex-col bg-accent p-6 text-brand-900 sm:p-8 lg:p-10">
            <p class="inline-flex w-fit rounded-full bg-brand-900 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white">
              Vision
            </p>
            <h3 class="mt-4 text-2xl font-extrabold leading-tight sm:text-3xl">
              Where we are taking home services in Kashmir
            </h3>
            <p class="mt-4 text-base leading-relaxed text-brand-900/75">
              Become Kashmir’s most trusted home-services company — local craftsmanship, modern
              booking, and one company responsible for the outcome.
            </p>
            <ul class="mt-6 space-y-3">
              {
                visionPoints.map((point) => (
                  <li class="flex items-start gap-3 text-sm leading-relaxed text-brand-900/90">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-900 text-white">
                      <Icon name="check" size={12} class="text-white" />
                    </span>
                    <span>{point}</span>
                  </li>
                ))
              }
            </ul>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- What Panun Kaergar does -->
  <section class="bg-slate-50" aria-labelledby="who-handles-heading">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="reveal flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
          <h2 id="who-handles-heading" class="text-3xl font-extrabold text-slate-900 sm:text-4xl">
            What Panun Kaergar does
          </h2>
          <p class="mt-3 text-lg text-slate-600">
            For customers we run the experience. For partners we bring the customer and handle the
            business around the service.
          </p>
        </div>
        <ul class="flex flex-wrap gap-4 text-sm font-medium text-slate-600" aria-label="Who we serve">
          <li class="inline-flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-brand-600" aria-hidden="true"></span>
            For customers
          </li>
          <li class="inline-flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-accent" aria-hidden="true"></span>
            For partners
          </li>
        </ul>
      </div>

      <div class="reveal mt-10 overflow-hidden rounded-[1.75rem] shadow-xl">
        <div class="grid items-stretch lg:grid-cols-2">
          <article class="flex flex-col bg-brand-900 text-white">
            <div class="flex items-center gap-3 border-b border-white/10 px-5 py-4 sm:px-6">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-brand-900 shadow-lg">
                <Icon name="home" size={20} />
              </span>
              <div>
                <p class="inline-flex rounded-full bg-white/10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white/80">
                  Customers
                </p>
                <h3 class="mt-1.5 text-lg font-extrabold leading-tight">What we do for households</h3>
                <p class="text-xs text-white/55">You hire Panun Kaergar. We stay responsible.</p>
              </div>
            </div>
            <ul class="grid flex-1 grid-cols-1 content-start gap-2 p-4 sm:grid-cols-2 sm:p-5">
              {
                forCustomers.map((item) => (
                  <li class="flex items-center gap-2.5 rounded-xl bg-white/10 px-3 py-2.5">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white text-brand-900">
                      <Icon name={item.icon} size={16} />
                    </span>
                    <span class="text-sm font-medium leading-snug text-white">{item.label}</span>
                  </li>
                ))
              }
            </ul>
          </article>
          <article class="flex flex-col bg-accent text-brand-900">
            <div class="flex items-center gap-3 border-b border-brand-900/10 px-5 py-4 sm:px-6">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-900 text-white shadow-lg">
                <Icon name="wrench" size={20} />
              </span>
              <div>
                <p class="inline-flex rounded-full bg-brand-900 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white">
                  Partners
                </p>
                <h3 class="mt-1.5 text-lg font-extrabold leading-tight">What we do for partners</h3>
                <p class="text-xs text-brand-900/65">You bring the skill. We handle the rest.</p>
              </div>
            </div>
            <ul class="grid flex-1 grid-cols-1 content-start gap-2 p-4 sm:grid-cols-2 sm:p-5">
              {
                forPartners.map((item) => (
                  <li class="flex items-center gap-2.5 rounded-xl bg-white/50 px-3 py-2.5">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-900 text-white">
                      <Icon name={item.icon} size={16} />
                    </span>
                    <span class="text-sm font-medium leading-snug text-brand-900">{item.label}</span>
                  </li>
                ))
              }
            </ul>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Heritage -->
  <section class="border-y border-slate-200 bg-white">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="reveal order-2 lg:order-1">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">
            Heritage meets modern life
          </p>
          <h2 class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
            From traditional skills to today’s home needs
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-slate-600">
            You hire Panun Kaergar. We manage the experience and get the work done — without losing
            Kashmir’s spirit of craftsmanship.
          </p>

          <ul class="mt-8 space-y-5">
            {
              bridgePoints.map((item, i) => (
                <li
                  class:list={[
                    'reveal border-l-2 border-brand-600 pl-4',
                    `reveal-stagger-${Math.min(i + 1, 6)}`,
                  ]}
                >
                  <h3 class="font-bold text-slate-900">{item.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-slate-600 sm:text-base">
                    {item.description}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="reveal-right order-1 lg:order-2">
          <div class="about-float-stack">
            <figure class="about-float-stack__main">
              <img
                src="/images/about/about-heritage-main.webp"
                alt="Traditional Kashmiri craftsmanship alongside modern home appliance care"
                width="1536"
                height="1024"
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </figure>
            <figure class="about-float-stack__float">
              <img
                src="/images/about/about-heritage-detail.webp"
                alt="Close-up of traditional woodworking craftsmanship in Kashmir"
                width="1536"
                height="1024"
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </figure>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Built by -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-[1400px] px-4 py-8 sm:px-6 sm:py-10 lg:px-10">
      <p class="reveal text-center text-sm text-slate-500">
        Panun Kaergar is developed and launched by{' '}
        <span class="font-semibold text-slate-700">{site.poweredByName ?? 'Gildware Technologies'}</span>.
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section-pad bg-brand-900 text-white">
    <div class="reveal mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-extrabold sm:text-4xl">Ready for a home visit?</h2>
      <p class="mt-4 text-lg text-blue-100/90">
        Tell us the job, your area, and a time. We’ll handle the rest.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={BOOK_PATH} class="btn-primary bg-white text-brand-600 hover:bg-brand-50">
          Book a service
        </a>
        <a
          href={PARTNER_PATH}
          class="inline-flex items-center rounded-xl border-2 border-white/40 px-5 py-2.5 text-sm font-semibold text-white transition hover:border-white/60 hover:bg-white/10"
        >
          Join as a partner
        </a>
      </div>
      <p class="mt-8 text-sm text-blue-100/90">
        Questions? Call{' '}
        <a href={`tel:${site.phone}`} class="font-semibold text-white underline-offset-2 hover:underline">
          {site.phone}
        </a>
        {' '}or{' '}
        <a
          href={customerWhatsAppHref}
          class="font-semibold text-white underline-offset-2 hover:underline"
        >
          WhatsApp us
        </a>
        .
      </p>
    </div>
  </section>
</PageLayout>

<style>
  .about-hero-mosaic {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    grid-template-rows: 1fr 1fr;
    gap: 0.75rem;
    min-height: 18rem;
  }

  .about-hero-mosaic__cell {
    margin: 0;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.18);
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.55);
    background: rgb(15 23 42 / 0.35);
  }

  .about-hero-mosaic__cell--1 {
    grid-row: 1 / span 2;
    animation: about-float 7s ease-in-out infinite;
  }

  .about-hero-mosaic__cell--2 {
    animation: about-float 8s ease-in-out infinite;
    animation-delay: -1.5s;
  }

  .about-hero-mosaic__cell--3 {
    animation: about-float 7.5s ease-in-out infinite;
    animation-delay: -3s;
  }

  .about-hero-mosaic__cell--4 {
    display: none;
  }

  @media (min-width: 640px) {
    .about-hero-mosaic {
      grid-template-columns: 1.2fr 0.9fr 0.9fr;
      grid-template-rows: 1fr 1fr;
      min-height: 20rem;
    }

    .about-hero-mosaic__cell--1 {
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .about-hero-mosaic__cell--2 {
      grid-column: 2;
      grid-row: 1;
    }

    .about-hero-mosaic__cell--3 {
      grid-column: 2;
      grid-row: 2;
    }

    .about-hero-mosaic__cell--4 {
      display: block;
      grid-column: 3;
      grid-row: 1 / span 2;
      animation: about-float 9s ease-in-out infinite;
      animation-delay: -2s;
    }
  }

  @keyframes about-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
