---
import PageLayout from '@/layouts/PageLayout.astro';
import StoreButton from '@/components/StoreButton.astro';
import PartnerApplicationForm from '@/components/PartnerApplicationForm.astro';
import JoinProcessStack from '@/components/JoinProcessStack.astro';
import FaqSection from '@/components/FaqSection.astro';
import AskQuestionForm from '@/components/AskQuestionForm.astro';
import Icon from '@/components/Icon.astro';
import { buildMeta } from '@/utils/seo';
import { faqSchema } from '@/utils/schema';
import { getSiteSettings, getServices } from '@/utils/reader';
import { whatsappHref, partnerWhatsAppMessage } from '@/utils/booking';

const site = await getSiteSettings();
const services = await getServices();
const partnerWhatsAppHref = whatsappHref(site.whatsapp, partnerWhatsAppMessage());

const meta = buildMeta({
  title: 'Become a Partner in Kashmir | Panun Kaergar',
  description:
    'Join Panun Kaergar as a service partner in Kashmir. You focus on the work — we handle booking, coordination, customer communication, and payments. Free to apply.',
  path: '/become-a-partner',
});

const reasons = [
  {
    icon: 'inbox',
    title: 'Customer jobs without the chasing',
    description:
      'Panun Kaergar brings service requests so you spend less time looking for the next customer.',
  },
  {
    icon: 'wrench',
    title: 'Focus on your trade',
    description:
      'We handle booking, coordination, and customer communication around the job. You deliver the service.',
  },
  {
    icon: 'wallet',
    title: 'Clear payout, settled by us',
    description:
      'See your applicable payout before you take a job. We set the customer price — no doorstep negotiation — and settle your agreed payout on the current daily and weekly terms.',
  },
  {
    icon: 'headset',
    title: 'Support if something goes wrong',
    description:
      'If a customer issue or service problem arises, our team coordinates the resolution process.',
  },
  {
    icon: 'check-circle',
    title: 'Free to join',
    description: 'No upfront application or listing fee to become a Panun Kaergar partner.',
  },
  {
    icon: 'user',
    title: 'Independent partner, not an employee',
    description:
      'You join as a professional partner or vendor. Panun Kaergar runs the customer experience; you fulfill assigned jobs to the agreed standards.',
  },
  {
    icon: 'smartphone',
    title: 'Jobs and payout in one app',
    description:
      'Accept work, update job status, and track settlements in the Partner app — without juggling chats.',
  },
  {
    icon: 'trending-up',
    title: 'Reliability can bring more work',
    description:
      'Strong service and customer feedback can lead to more opportunities, subject to demand and availability.',
  },
];

const workSteps = [
  {
    n: '01',
    who: 'we',
    icon: 'inbox',
    title: 'We bring the customer',
    description: 'Panun Kaergar generates and manages customer service requests.',
  },
  {
    n: '02',
    who: 'we',
    icon: 'calendar',
    title: 'We manage the booking',
    description: 'We handle the booking, applicable pricing, and customer coordination.',
  },
  {
    n: '03',
    who: 'you',
    icon: 'wrench',
    title: 'You fulfill the service',
    description:
      'You visit the customer and perform the service according to Panun Kaergar’s service standards.',
  },
  {
    n: '04',
    who: 'we',
    icon: 'headset',
    title: 'We support the experience',
    description:
      'Our team manages customer communication, payment coordination, and service-related support.',
  },
  {
    n: '05',
    who: 'we',
    icon: 'wallet',
    title: 'We settle your payout',
    description:
      'Partner earnings are settled by Panun Kaergar according to the applicable commercial and payment terms.',
  },
];

const operatingFlow = [
  { label: 'Customer request', sub: 'Job comes in', icon: 'inbox', who: 'in' },
  { label: 'Panun Kaergar', sub: 'Book & allocate', icon: 'building', who: 'we' },
  { label: 'Partner', sub: 'Do the work', icon: 'user', who: 'you' },
  { label: 'Service completed', sub: 'Job closed', icon: 'check-circle', who: 'in' },
  { label: 'Panun Kaergar', sub: 'Support & collect', icon: 'headset', who: 'we' },
  { label: 'Partner settlement', sub: 'We settle payout', icon: 'wallet', who: 'we' },
];

const pkHandles = [
  { icon: 'inbox', label: 'Customer acquisition' },
  { icon: 'calendar', label: 'Booking' },
  { icon: 'wallet', label: 'Customer pricing' },
  { icon: 'message', label: 'Customer communication' },
  { icon: 'map-pin', label: 'Job coordination' },
  { icon: 'user', label: 'Provider allocation' },
  { icon: 'check-circle', label: 'Payment collection' },
  { icon: 'headset', label: 'Customer support' },
  { icon: 'star', label: 'Feedback' },
  { icon: 'trending-up', label: 'Quality monitoring' },
  { icon: 'shield-check', label: 'Issue coordination' },
];

const youHandle = [
  { icon: 'check-circle', label: 'Accept assigned jobs' },
  { icon: 'clock', label: 'Arrive on time' },
  { icon: 'wrench', label: 'Perform the service' },
  { icon: 'shield-check', label: 'Follow service standards' },
  { icon: 'hammer', label: 'Bring the right tools' },
  { icon: 'smartphone', label: 'Update job status' },
  { icon: 'user', label: 'Professional conduct' },
  { icon: 'message', label: 'Report issues promptly' },
  { icon: 'check', label: 'Complete the work properly' },
];

const pageFaqs = [
  {
    question: 'Who can apply to become a Panun Kaergar service partner?',
    answer:
      'Skilled professionals, service businesses, teams, and specialist providers can apply — plumbers, electricians, carpenters, cleaners, appliance technicians, and other home-service trades we operate. You should be able to serve areas in Kashmir, bring the tools for your work, and meet our applicable verification and service-standard requirements. Individuals, small businesses, and teams are all eligible to apply.',
  },
  {
    question: 'How do tradespeople and service businesses apply to join as a Panun Kaergar partner?',
    answer:
      'A plumber, electrician, carpenter, cleaner, technician, or other home-service professional — including an individual, a business, or a team — applies to join as an independent Panun Kaergar service partner, not as an employee. Apply in four ways: fill the form on this page, apply in the Partner app, call us, or message us on WhatsApp. Share your name, trade or service category, the areas you serve, years of experience, and a short description of the work you do. There is no application fee. Our team reviews your information and contacts you with the next step.',
  },
  {
    question: 'Is there a fee to join Panun Kaergar as a service partner?',
    answer:
      'No. There is no upfront application fee and no listing fee to become a Panun Kaergar partner. You apply, get verified, complete onboarding, and become eligible for relevant jobs. You bring your own tools and equipment for your trade.',
  },
  {
    question: 'Are Panun Kaergar service partners employees of the company?',
    answer:
      'No. You join as an independent service partner, vendor, or specialist — not as an employee and not on a salary. Panun Kaergar runs the customer experience: acquisition, booking, pricing, coordination, communication, payment, and support. You remain independent and fulfill assigned jobs according to the agreed terms and service standards.',
  },
  {
    question: 'Do I need to work full-time after I join as a partner?',
    answer:
      'No. You are not required to work full-time, and you are not an employee. You receive relevant job opportunities for your categories and areas. When you accept a Panun Kaergar job, you are expected to complete that visit — arrive on time, do the work properly, and update the job status in the Partner app.',
  },
  {
    question: 'Do partners need to find their own customers?',
    answer:
      'No. Panun Kaergar generates customer demand, takes the booking, and allocates relevant service opportunities to partners. You do not need to advertise, chase leads, or negotiate at the door. Your role is to fulfill the assigned job to our service standards.',
  },
  {
    question: 'Who sets the customer price, and how is the partner payout decided?',
    answer:
      'Panun Kaergar sets the customer-facing price according to the applicable service pricing structure. You see your agreed partner payout before you take the job. There is no doorstep price negotiation with the household — you do not quote, discount, or collect a separate amount from the customer.',
  },
  {
    question: 'How do Panun Kaergar partners get paid after completing a job?',
    answer:
      'Panun Kaergar collects payment from the customer and settles your agreed payout. You do not take cash at the door as a private arrangement. Settlements currently run on daily and weekly terms, and you can track jobs and payouts in the Partner app. The amount you receive is the payout shown when you accept the job, according to the applicable commercial terms.',
  },
  {
    question: 'Who speaks with the customer — Panun Kaergar or the partner?',
    answer:
      'Panun Kaergar owns the customer relationship. We handle booking, scheduling, pricing questions, updates, payment, and support. You focus on the visit: arriving on time, performing the service, updating job status, and reporting issues promptly if something comes up on site.',
  },
  {
    question: 'What tools and equipment does a partner need to bring to a job?',
    answer:
      'Bring the tools, equipment, and skill required for the services you offer. Arrive ready to complete the job to Panun Kaergar service standards. Keep the Partner app available so you can accept work, update status, and report issues during the visit.',
  },
  {
    question: 'What happens if a customer complains after a partner visit?',
    answer:
      'The customer contacts Panun Kaergar, not you personally, for support. Our team coordinates the complaint, investigates the service issue according to applicable policies, and determines the next step. You may be asked for job details or to return if a rework is required under those policies.',
  },
  {
    question: 'What should I do if I cannot complete a job I already accepted?',
    answer:
      'Notify Panun Kaergar as soon as you know you cannot complete an accepted visit — through the Partner app, a call, or WhatsApp. Do not leave the customer without telling us. Operations will decide the appropriate next step, which may include reallocation. Repeated no-shows or late cancellations can affect partner standing.',
  },
  {
    question: 'What happens if a partner keeps receiving poor customer ratings?',
    answer:
      'Customer feedback and service quality are monitored after jobs. Consistently poor ratings, missed visits, or failure to follow service standards can affect the jobs you receive, your eligibility, or continuation as a partner, according to the partner agreement. Strong, reliable work can lead to more relevant opportunities, subject to demand and availability.',
  },
  {
    question: 'Can a partner choose which Panun Kaergar jobs to accept?',
    answer:
      'You receive opportunities that match your verified categories and service areas. Review the job details and your payout in the Partner app before you accept. Once you accept a Panun Kaergar job, you complete that visit — including arriving on time, doing the work, and updating the status.',
  },
];

const steps = [
  {
    n: 1,
    title: 'Apply',
    desc: 'Join free by filling the form on this page, applying in the Partner app, calling us, or messaging us on WhatsApp. Tell us your trade, the areas you serve, and your experience.',
    image: '/images/join-process/01-download.webp',
    imageAlt: 'Applying to join Panun Kaergar as a service partner',
  },
  {
    n: 2,
    title: 'Get verified',
    desc: 'Our team reviews your application, checks applicable identity and trade details, and confirms the areas you can serve. We may call or WhatsApp you if anything needs clarifying.',
    image: '/images/join-process/02-signup.webp',
    imageAlt: 'Partner information under review',
  },
  {
    n: 3,
    title: 'Get onboarded',
    desc: 'You learn how Panun Kaergar jobs are assigned, what service standards apply on a visit, how to update job status in the Partner app, and how payouts are settled.',
    image: '/images/join-process/03-verified.webp',
    imageAlt: 'Partner learning Panun Kaergar service standards',
  },
  {
    n: 4,
    title: 'Get activated',
    desc: 'After approval, your partner profile is switched on. You become eligible for relevant jobs in your categories and service areas, based on demand and your availability.',
    image: '/images/join-process/04-categories.webp',
    imageAlt: 'Partner profile activated for Panun Kaergar jobs',
  },
  {
    n: 5,
    title: 'Start fulfilling jobs',
    desc: 'Accept a job in the Partner app, complete the visit to our standards, update the status, and receive your agreed payout on the current daily and weekly settlement terms. If you accept a job, you complete that visit.',
    image: '/images/join-process/05-accept-earn.webp',
    imageAlt: 'Partner fulfilling a Panun Kaergar customer job',
  },
];

---

<PageLayout meta={meta} schemas={[faqSchema(pageFaqs)].filter(Boolean)} hideStickyCta>
  <!-- Hero: match home page layout -->
  <section
    class="relative overflow-hidden bg-brand-900 bg-gradient-to-br from-brand-900 via-brand-600 to-brand-700 text-white"
    style="background-color: #121228; color: #ffffff;"
  >
    <div class="hero-blob -left-24 top-0 h-72 w-72 bg-brand-500/30" style="animation-delay: 0s;" aria-hidden="true"></div>
    <div class="hero-blob -right-16 bottom-0 h-96 w-96 bg-accent/20" style="animation-delay: -5s;" aria-hidden="true"></div>
    <div class="hero-blob left-1/3 top-1/2 h-48 w-48 bg-white/10" style="animation-delay: -9s;" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-9 lg:py-14">
      <div class="flex flex-col gap-5 lg:grid lg:grid-cols-2 lg:items-start lg:gap-12">
        <h1
          class="animate-fade-up text-xl font-extrabold leading-snug text-white sm:text-2xl lg:col-start-1 lg:row-start-1 lg:text-[2.85rem] lg:leading-[1.1]"
          style="color: #ffffff;"
        >
          You Do the Work. We Handle the Rest.
        </h1>

        <div class="lg:col-start-2 lg:row-start-1 lg:row-span-2">
          <div
            class="animate-slide-right stagger-2 scroll-mt-24 rounded-2xl bg-white p-4 text-slate-900 shadow-2xl transition-shadow duration-500 hover:shadow-[0_25px_50px_-12px_rgba(0,0,0,0.35)] sm:p-6"
            id="partner-form"
            style="background-color: #ffffff; color: #0f172a;"
          >
            <PartnerApplicationForm
              site={site}
              services={services}
              formId="hero-partner-form"
              heading="Apply to Become a Partner"
              variant="compact"
              heroMode={true}
            />
          </div>
        </div>

        <div class="lg:col-start-1 lg:row-start-2">
          <p class="animate-fade-up stagger-1 inline-flex max-w-full items-center rounded-full border border-white/25 bg-white/10 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-white/90 backdrop-blur-sm">
            For skilled professionals, service businesses and specialist providers
          </p>
          <p class="animate-fade-up stagger-2 mt-3 max-w-xl text-base leading-relaxed text-white/85 sm:text-lg">
            Join as a service partner. We bring the customer and manage booking, pricing, coordination, communication, and payment — so you can focus on delivering great service.
          </p>

          <ul class="animate-fade-up stagger-3 mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/80 sm:mt-6 sm:gap-x-6 sm:gap-y-3">
            <li class="flex items-center gap-2">
              <Icon name="check" size={17} class="text-white" />
              Free to join
            </li>
            <li class="animate-fade-in stagger-4 flex items-center gap-2">
              <Icon name="check" size={17} class="text-white" />
              Clear partner payout
            </li>
            <li class="animate-fade-in stagger-5 flex items-center gap-2">
              <Icon name="check" size={17} class="text-white" />
              We manage the customer experience
            </li>
          </ul>

          <div class="animate-fade-up stagger-4 mt-6 flex flex-wrap gap-3">
            <a
              href={`tel:${site.phone}`}
              class="inline-flex items-center gap-2 rounded-xl border-2 border-white/40 px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 ease-smooth hover:-translate-y-0.5 hover:border-white/60 hover:bg-white/10"
            >
              <Icon name="phone" size={18} />
              Call {site.phone}
            </a>
            <a
              href={partnerWhatsAppHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl border-2 border-emerald-300/50 px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 ease-smooth hover:-translate-y-0.5 hover:border-emerald-300/80 hover:bg-emerald-400/15"
            >
              <Icon name="whatsapp" size={18} />
              WhatsApp
            </a>
          </div>

          <div class="animate-fade-up stagger-5 mt-4 hidden flex-wrap gap-3 lg:flex">
            <StoreButton store="google-play" href={site.providerPlayStoreUrl} />
            <StoreButton store="app-store" href={site.providerAppStoreUrl} />
          </div>

          <p class="animate-fade-up mt-4 text-center text-xs text-white/70 lg:hidden">
            Call · WhatsApp · Partner app · Kashmir
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why join -->
  <section class="border-y border-slate-200 bg-white">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-extrabold text-slate-900">Why partner with Panun Kaergar</h2>
        <p class="mt-3 text-lg text-slate-600">
          What joining the network gives you — without running the whole customer business.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          reasons.map((item, i) => (
            <article
              class:list={[
                'reveal-scale card card-hover p-5 sm:p-6',
                `reveal-stagger-${Math.min(i + 1, 6)}`,
              ]}
            >
              <span class="icon-badge">
                <Icon name={item.icon} size={22} class="text-brand-600" />
              </span>
              <h3 class="mt-4 text-base font-bold leading-snug text-slate-900">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How Panun Kaergar works with you -->
  <section class="bg-slate-50" aria-labelledby="how-it-works-heading">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="reveal flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">The operating model</p>
          <h2 id="how-it-works-heading" class="mt-3 text-3xl font-extrabold text-slate-900 sm:text-4xl">
            How Panun Kaergar works with you
          </h2>
          <p class="mt-3 text-lg text-slate-600">
            From the customer request to your payout — one operating process.
          </p>
        </div>
        <ul class="flex flex-wrap gap-4 text-sm font-medium text-slate-600" aria-label="Process roles">
          <li class="inline-flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-brand-600" aria-hidden="true"></span>
            We handle this
          </li>
          <li class="inline-flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-accent" aria-hidden="true"></span>
            You do this
          </li>
        </ul>
      </div>

      <div class="reveal mt-10 overflow-hidden rounded-[1.75rem] bg-brand-900 text-white shadow-xl">
        <div class="border-b border-white/10 px-5 py-8 sm:px-8 lg:px-10 lg:py-10">
          <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/45">End-to-end flow</p>
          <div class="relative mt-8">
            <span
              class="pointer-events-none absolute left-[8%] right-[8%] top-7 hidden h-px bg-gradient-to-r from-transparent via-white/25 to-transparent xl:block"
              aria-hidden="true"
            ></span>
            <ol class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 xl:grid-cols-6 xl:gap-x-0" aria-label="Service operating flow">
              {
                operatingFlow.map((item, i) => (
                  <li class="relative flex flex-col items-center text-center">
                    <span
                      class:list={[
                        'relative z-10 flex h-14 w-14 items-center justify-center rounded-full shadow-lg',
                        item.who === 'you' && 'bg-accent text-brand-900',
                        item.who === 'we' && 'bg-white text-brand-900',
                        item.who === 'in' && 'bg-white/10 text-white ring-1 ring-white/25',
                      ]}
                    >
                      <Icon name={item.icon} size={22} />
                    </span>
                    <p class="mt-3 text-[11px] font-bold tracking-widest text-white/40">
                      {String(i + 1).padStart(2, '0')}
                    </p>
                    <p class="mt-1 text-sm font-semibold leading-snug text-white">{item.label}</p>
                    <p class="mt-0.5 text-xs text-white/55">{item.sub}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>

        <div class="grid divide-y divide-white/10 lg:grid-cols-5 lg:divide-x lg:divide-y-0">
          {
            workSteps.map((item, i) => (
              <article
                class:list={[
                  'group relative flex flex-col px-5 py-6 sm:px-6 sm:py-8',
                  `reveal-stagger-${Math.min(i + 1, 6)}`,
                ]}
              >
                <span
                  class:list={[
                    'absolute inset-x-0 top-0 h-1',
                    item.who === 'you' ? 'bg-accent' : 'bg-white/35',
                  ]}
                  aria-hidden="true"
                ></span>
                <div class="flex items-center justify-between gap-3">
                  <span
                    class:list={[
                      'flex h-11 w-11 items-center justify-center rounded-xl',
                      item.who === 'you' ? 'bg-accent/15 text-accent' : 'bg-white/10 text-white',
                    ]}
                  >
                    <Icon name={item.icon} size={20} />
                  </span>
                  <p class="text-2xl font-extrabold tabular-nums text-white/20">{item.n}</p>
                </div>
                <p
                  class:list={[
                    'mt-5 inline-flex w-fit rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider',
                    item.who === 'you' ? 'bg-accent text-brand-900' : 'bg-white/10 text-white/80',
                  ]}
                >
                  {item.who === 'you' ? 'You' : 'We'}
                </p>
                <h3 class="mt-3 text-base font-bold leading-snug text-white">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-white/65">{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Who handles what -->
  <section class="bg-slate-50" aria-labelledby="who-handles-heading">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="reveal flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
          <h2 id="who-handles-heading" class="text-3xl font-extrabold text-slate-900 sm:text-4xl">
            Who handles what?
          </h2>
          <p class="mt-3 text-lg text-slate-600">
            Panun Kaergar owns the customer relationship. You fulfill the work to our standards. There is
            no doorstep price negotiation with the household.
          </p>
        </div>
        <ul class="flex flex-wrap gap-4 text-sm font-medium text-slate-600" aria-label="Process roles">
          <li class="inline-flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-brand-600" aria-hidden="true"></span>
            We handle this
          </li>
          <li class="inline-flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-accent" aria-hidden="true"></span>
            You do this
          </li>
        </ul>
      </div>

      <div class="reveal mt-10 overflow-hidden rounded-[1.75rem] shadow-xl">
        <div class="grid items-stretch lg:grid-cols-2">
          <article class="flex flex-col bg-brand-900 text-white">
            <div class="flex items-center gap-3 border-b border-white/10 px-5 py-4 sm:px-6">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-brand-900 shadow-lg">
                <Icon name="building" size={20} />
              </span>
              <div>
                <p class="inline-flex rounded-full bg-white/10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white/80">
                  We
                </p>
                <h3 class="mt-1.5 text-lg font-extrabold leading-tight">Panun Kaergar handles</h3>
                <p class="text-xs text-white/55">The customer-facing business</p>
              </div>
            </div>
            <ul class="grid flex-1 grid-cols-1 content-start gap-2 p-4 sm:grid-cols-2 sm:p-5">
              {
                pkHandles.map((item) => (
                  <li class="flex items-center gap-2.5 rounded-xl bg-white/10 px-3 py-2.5">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white text-brand-900">
                      <Icon name={item.icon} size={16} />
                    </span>
                    <span class="text-sm font-medium leading-snug text-white">{item.label}</span>
                  </li>
                ))
              }
            </ul>
          </article>
          <article class="flex flex-col bg-accent text-brand-900">
            <div class="flex items-center gap-3 border-b border-brand-900/10 px-5 py-4 sm:px-6">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-900 text-white shadow-lg">
                <Icon name="wrench" size={20} />
              </span>
              <div>
                <p class="inline-flex rounded-full bg-brand-900 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white">
                  You
                </p>
                <h3 class="mt-1.5 text-lg font-extrabold leading-tight">You handle</h3>
                <p class="text-xs text-brand-900/65">The work on site</p>
              </div>
            </div>
            <ul class="grid flex-1 grid-cols-1 content-start gap-2 p-4 sm:grid-cols-2 sm:p-5">
              {
                youHandle.map((item) => (
                  <li class="flex items-center gap-2.5 rounded-xl bg-white/50 px-3 py-2.5">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-900 text-white">
                      <Icon name={item.icon} size={16} />
                    </span>
                    <span class="text-sm font-medium leading-snug text-brand-900">{item.label}</span>
                  </li>
                ))
              }
            </ul>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Process: stacked cards -->
  <JoinProcessStack
    steps={steps}
    heading="How to join"
    lede="From application to fulfilling Panun Kaergar customer jobs."
  />

  <section class="border-t border-slate-200 bg-white" id="faqs" aria-labelledby="partner-faqs-heading">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="reveal max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">FAQs</p>
        <h2 id="partner-faqs-heading" class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
          Partner questions
        </h2>
        <p class="mt-3 text-lg text-slate-600">
          Joining, payouts, jobs, and what happens when something goes off plan.
        </p>
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start xl:grid-cols-[minmax(0,1fr)_24rem] xl:gap-12">
        <div class="min-w-0">
          <FaqSection items={pageFaqs} compact class="!py-0" />
        </div>

        <aside class="lg:sticky lg:top-24">
          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
            <div class="flex items-start gap-3">
              <span class="icon-badge shrink-0">
                <Icon name="message" size={20} />
              </span>
              <div>
                <h3 class="text-lg font-extrabold text-slate-900">Ask a question</h3>
                <p class="mt-1 text-sm text-slate-600">
                  Can’t find an answer? Send it and we’ll get back to you.
                </p>
              </div>
            </div>
            <div class="mt-5">
              <AskQuestionForm
                site={site}
                formId="partner-ask-question-form"
                placeholder="What would you like to know about becoming a partner?"
                sourceLine="Sent via panunkaergar.com become-a-partner page"
              />
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section-pad bg-brand-900 text-white">
    <div class="reveal mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-extrabold sm:text-4xl">Ready to join the network?</h2>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="#partner-form" class="btn-primary bg-white text-brand-600 hover:bg-brand-50">
          Become a Partner
        </a>
        <StoreButton store="google-play" href={site.providerPlayStoreUrl} />
        <StoreButton store="app-store" href={site.providerAppStoreUrl} />
      </div>
      <p class="mt-8 text-sm text-blue-100/90">
        Questions about joining? Call{' '}
        <a href={`tel:${site.phone}`} class="font-semibold text-white underline-offset-2 hover:underline">
          {site.phone}
        </a>
        {' '}or{' '}
        <a
          href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}`}
          class="font-semibold text-white underline-offset-2 hover:underline"
        >
          WhatsApp us
        </a>
        .
      </p>
    </div>
  </section>
</PageLayout>
