---
import PageLayout from '@/layouts/PageLayout.astro';
import CategoryMarquee from '@/components/CategoryMarquee.astro';
import FaqSection from '@/components/FaqSection.astro';
import BookingOptions from '@/components/BookingOptions.astro';
import JoinProcessStack from '@/components/JoinProcessStack.astro';
import AskQuestionForm from '@/components/AskQuestionForm.astro';
import Icon from '@/components/Icon.astro';
import { buildMeta } from '@/utils/seo';
import { getSiteSettings, getServices, getAreas } from '@/utils/reader';
import { breadcrumbSchema, faqSchema } from '@/utils/schema';
import { BOOK_PATH, whatsappHref } from '@/utils/booking';

const site = await getSiteSettings();
const services = await getServices();
const areas = await getAreas();
const customerWhatsAppHref = whatsappHref(
  site.whatsapp,
  'Hello Panun Kaergar, I would like to book a home service.',
);

const categories = services.map((s) => ({
  slug: s.slug,
  shortName: s.shortName,
}));

const PAGE_PATH = '/why-choose-panun-kaergar';

const meta = buildMeta({
  title: 'Why Book Panun Kaergar Instead of Calling Yourself | Kashmir',
  description:
    'Stop hunting plumber and electrician numbers in Kashmir. Panun Kaergar takes one request, confirms the price, sends the right professional, manages payment, and stays responsible until the job is done.',
  path: PAGE_PATH,
});

const storyImages = [
  {
    src: '/images/why-choose/why-choose-booking.webp',
    alt: 'A household booking home help while a professional arrives at the door',
  },
  {
    src: '/images/why-choose/why-choose-verified.webp',
    alt: 'A Panun Kaergar professional introducing themselves at a Kashmiri home',
  },
  {
    src: '/images/why-choose/why-choose-local.webp',
    alt: 'Home repair underway in a Kashmiri household',
  },
  {
    src: '/images/why-choose/why-choose-hero.webp',
    alt: 'A completed home visit with a household in Kashmir',
  },
];

const problemSolutions = [
  {
    icon: 'phone',
    problem: 'Calling numbers that never pick up',
    problemDetail:
      'You ask neighbours for a plumber or electrician number, try three more, and still get silence when the tap is leaking or the power is out.',
    solution:
      'Send one request to Panun Kaergar. We take the job and assign a professional suited to the work — you stop hunting private numbers across Kashmir.',
    image: '/images/why-choose/split-calling.webp',
    imageAlt:
      'On your own: calling plumber numbers that do not answer. With Panun Kaergar: one request, and we send the professional.',
  },
  {
    icon: 'clock',
    problem: 'Waiting all day for a callback that never comes',
    problemDetail:
      'Someone says they will confirm in the evening. Hours pass. You still do not know if anyone is coming to the house.',
    solution:
      'After you book, Panun Kaergar follows through on the visit. You deal with the company — not a private phone that goes quiet.',
    image: '/images/why-choose/split-callback.webp',
    imageAlt:
      'On your own: waiting for a callback that never comes. With Panun Kaergar: the company follows through on the booking.',
  },
  {
    icon: 'wallet',
    problem: 'A different price every time you hire help at home',
    problemDetail:
      'One quote on the phone, another at the door, extras added once work has started — you are negotiating every plumbing, electrical, or cleaning job.',
    solution:
      'We confirm an estimate before work begins for most services. Extra parts or labour are explained before the job continues, so you are not guessing the bill.',
    image: '/images/why-choose/split-pricing.webp',
    imageAlt:
      'On your own: negotiating a new price on every home job. With Panun Kaergar: an estimate confirmed before work starts.',
  },
  {
    icon: 'user',
    problem: 'Nobody shows up for the visit',
    problemDetail:
      'You cleared the morning for a plumber, electrician, or cleaner, stayed home, and nobody is at the door. Then you start calling around again for the same job.',
    solution:
      'We coordinate the appointment and keep the visit on track. If something slips, you contact Panun Kaergar — you do not chase a no-show on a personal number.',
    image: '/images/why-choose/split-noshow.webp',
    imageAlt:
      'On your own: nobody arrives for the home visit. With Panun Kaergar: a professional is coordinated to the door.',
  },
  {
    icon: 'smartphone',
    problem: 'Coordinating every home visit yourself',
    problemDetail:
      'You juggle times, reminders, “I am on the way” messages, and a second trade if the first job uncovers another problem.',
    solution:
      'Tell us the job, your area, and a preferred time. Panun Kaergar manages the booking and the appointment so you are not running the schedule.',
    image: '/images/why-choose/split-coordinate.webp',
    imageAlt:
      'On your own: coordinating every detail of a home visit. With Panun Kaergar: we manage the booking and the slot.',
  },
  {
    icon: 'trending-up',
    problem: 'Chasing the job until someone actually finishes it',
    problemDetail:
      'Work starts, then stalls. You call again to ask when they will return with the part, or whether the repair was ever completed.',
    solution:
      'We follow up until the work is done. You booked Panun Kaergar for the job — you should not have to project-manage a private technician.',
    image: '/images/why-choose/split-chasing.webp',
    imageAlt:
      'On your own: chasing a technician to finish the work. With Panun Kaergar: we follow up until the job is complete.',
  },
  {
    icon: 'star',
    problem: 'Not knowing if the work will hold after they leave',
    problemDetail:
      'The tap works today. You have no idea if the wiring is safe, the leak will return, or anyone will stand behind the work next week.',
    solution:
      'We check the finished job against our standards. If it is not right, you come back to Panun Kaergar — the company stays responsible for the visit.',
    image: '/images/why-choose/split-quality.webp',
    imageAlt:
      'On your own: unfinished or uncertain home repair. With Panun Kaergar: the completed job is checked against our standards.',
  },
  {
    icon: 'check-circle',
    problem: 'Paying cash to whoever shows up, with no company behind it',
    problemDetail:
      'You hand money to a private number at the door. If the price changes or the work fails, there is no clear record and no one to call but that person.',
    solution:
      'Payment is managed through Panun Kaergar. You are dealing with the company for the amount we agreed — not settling privately with whoever arrives.',
    image: '/images/why-choose/split-payment.webp',
    imageAlt:
      'On your own: paying a private technician in cash. With Panun Kaergar: payment is handled through the company.',
  },
  {
    icon: 'headset',
    problem: 'Nowhere to turn if the home service goes wrong',
    problemDetail:
      'The number stops answering. You have no office, no ticket, and no second visit unless you start the hunt for help all over again.',
    solution:
      'Support sits with Panun Kaergar. Call or WhatsApp us with your booking details — you come back to the company, not a technician’s personal phone.',
    image: '/images/why-choose/split-support.webp',
    imageAlt:
      'On your own: nowhere to turn after a bad visit. With Panun Kaergar: you come back to the company for support.',
  },
];

const pkFeatures = [
  {
    icon: 'smartphone',
    title: 'Book the way you like',
    description:
      'Call, WhatsApp, website, or the app. One request — however you prefer to reach us.',
    image: '/images/why-choose/feature-book.webp',
    imageAlt: 'A household booking a home service on their phone',
  },
  {
    icon: 'target',
    title: 'We size the job first',
    description:
      'Tell us what’s needed. We review the request before anyone is sent, so the visit matches the work.',
    image: '/images/why-choose/feature-analyse.webp',
    imageAlt: 'A Panun Kaergar coordinator reviewing a service request',
  },
  {
    icon: 'wallet',
    title: 'Price before work starts',
    description:
      'We confirm an estimate so you’re not negotiating at the door. Extra work is explained before it continues.',
    image: '/images/why-choose/feature-estimate.webp',
    imageAlt: 'A household reviewing a service estimate before work begins',
  },
  {
    icon: 'user',
    title: 'The right person for the job',
    description:
      'We assign a professional suited to the work. You don’t hunt for a number or hope the next call picks up.',
    image: '/images/why-choose/feature-professional.webp',
    imageAlt: 'A Panun Kaergar professional arriving at a Kashmiri home',
  },
  {
    icon: 'calendar',
    title: 'We keep the visit on track',
    description:
      'Timing, follow-up, and coordination stay with Panun Kaergar — so you are not managing the job yourself.',
    image: '/images/why-choose/feature-coordinate.webp',
    imageAlt: 'A coordinator confirming a home visit time',
  },
  {
    icon: 'check-circle',
    title: 'Pay Panun Kaergar, not a private number',
    description:
      'Payment is managed through us. You’re dealing with a company, not whoever happens to show up.',
    image: '/images/why-choose/feature-payment.webp',
    imageAlt: 'A household paying through Panun Kaergar while work is completed',
  },
  {
    icon: 'shield-check',
    title: 'Work we stand behind',
    description:
      'We check the finished job against our standards. If it isn’t right, you come back to us.',
    image: '/images/why-choose/feature-quality.webp',
    imageAlt: 'A professional checking completed home repair with the household',
  },
  {
    icon: 'headset',
    title: 'One company if something isn’t right',
    description:
      'You don’t chase a technician’s personal phone. You come back to Panun Kaergar.',
    image: '/images/why-choose/feature-support.webp',
    imageAlt: 'A customer getting support from Panun Kaergar after a visit',
  },
];

const helpSteps = [
  {
    n: 1,
    title: 'You tell us the job',
    desc: 'Job, area, and preferred time — phone, WhatsApp, website, or app.',
    image: '/images/features/features-booking.webp',
    imageAlt: 'Booking a home service by phone, WhatsApp, or website',
  },
  {
    n: 2,
    title: 'We analyse the request',
    desc: 'We review the job, confirm the service type, and scope the work.',
    image: '/images/features/features-custom-jobs.webp',
    imageAlt: 'Reviewing a custom home service request',
  },
  {
    n: 3,
    title: 'You get an estimate',
    desc: 'We confirm the expected price before work begins.',
    image: '/images/features/features-app.webp',
    imageAlt: 'Checking a service estimate on the Panun Kaergar app',
  },
  {
    n: 4,
    title: 'We send the right professional',
    desc: 'We assign a professional suited to the job and coordinate the visit.',
    image: '/images/why-choose/why-choose-verified.webp',
    imageAlt: 'A Panun Kaergar professional arriving at a Kashmiri home',
  },
  {
    n: 5,
    title: 'The work gets done',
    desc: 'The visit is completed. Payment is managed through Panun Kaergar.',
    image: '/images/why-choose/why-choose-local.webp',
    imageAlt: 'Home repair underway in a Kashmiri household',
  },
  {
    n: 6,
    title: 'We check the quality',
    desc: 'We stand behind the work. If it isn’t right, you come back to us.',
    image: '/images/why-choose/why-choose-hero.webp',
    imageAlt: 'A completed home visit with a household in Kashmir',
  },
];

const pageFaqs = [
  {
    question: 'Why should I book Panun Kaergar instead of calling a plumber, electrician, or cleaner myself?',
    answer:
      'When you call around yourself, you hunt for numbers, wait for callbacks, compare prices, coordinate the visit, and chase the job if something goes wrong. With Panun Kaergar you make one request. We analyse the job, confirm an estimate, send the right professional, manage payment, and stay with you until the work is done.',
  },
  {
    question: 'If I book Panun Kaergar, who actually comes to my home to do the work?',
    answer:
      'A Panun Kaergar professional suited to the job. You booked the company — not a private number. If the visit is not right, you come back to Panun Kaergar, not a technician’s personal phone.',
  },
  {
    question: 'How do I know what the job will cost before someone starts work in my home?',
    answer:
      'We confirm an estimate or rate before the visit for most services. If extra materials or labour are needed, that should be explained before work continues. Payment is managed through Panun Kaergar — not handed to whoever happens to show up.',
  },
  {
    question: 'What happens if I am not happy with the work after the visit?',
    answer:
      'Come back to us by phone or WhatsApp with your booking details. We review the issue and work toward a fair next step, which may include a revisit or follow-up. You do not have to chase a private number.',
  },
  {
    question: 'How do I book — do I need the Panun Kaergar app, or can I call and WhatsApp?',
    answer:
      'Use whatever is easiest: call, WhatsApp, the website form, or the app. Tell us the job, your area, and a preferred time. You do not need the app to book.',
  },
  {
    question: 'What happens after I send a request — do I still have to coordinate the visit myself?',
    answer:
      'No. We review the request, confirm the estimate, assign the professional, and keep the visit on track. You should not have to make a chain of calls to get someone to the door.',
  },
  {
    question: 'What if the professional does not show up, or I have to keep chasing the job?',
    answer:
      'That is the usual hassle when you book a private number. With Panun Kaergar we coordinate the visit and follow up. If something slips, you contact us — we stay responsible for the booking.',
  },
  {
    question: 'Can I book more than one kind of home help through Panun Kaergar?',
    answer:
      'Yes. Plumbing, electrical, carpentry, cleaning, appliances, salon, and other home services are booked the same way. One company for the house, instead of a different number for every job.',
  },
  {
    question: 'How is payment handled — do I pay the person who comes to the door?',
    answer:
      'Payment is managed through Panun Kaergar. You are dealing with the company, not settling privately with whoever arrives.',
  },
  {
    question: 'Which areas in Kashmir does Panun Kaergar cover?',
    answer: `Homes across Kashmir including ${areas
      .slice(0, 5)
      .map((a) => a.displayName)
      .join(', ')}, and more. Mention your neighbourhood when you book so we can confirm coverage.`,
  },
];

const schemas = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Why Choose Panun Kaergar', path: PAGE_PATH },
  ]),
  faqSchema(pageFaqs),
].filter(Boolean);
---

<PageLayout meta={meta} schemas={schemas}>
  <!-- 1. Hero: the problem -->
  <section
    class="relative overflow-hidden bg-brand-900 bg-gradient-to-br from-brand-900 via-brand-600 to-brand-700 text-white"
    style="background-color: #121228; color: #ffffff;"
  >
    <div class="hero-blob -left-24 top-0 h-72 w-72 bg-brand-500/30" style="animation-delay: 0s;" aria-hidden="true"></div>
    <div class="hero-blob -right-16 bottom-0 h-96 w-96 bg-accent/20" style="animation-delay: -5s;" aria-hidden="true"></div>
    <div class="hero-blob left-1/3 top-1/2 h-48 w-48 bg-white/10" style="animation-delay: -9s;" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-9 lg:py-14">
      <div class="flex flex-col gap-5 lg:grid lg:grid-cols-2 lg:items-start lg:gap-12">
        <h1
          class="animate-fade-up text-[1.35rem] font-extrabold leading-snug text-white sm:text-[1.75rem] lg:col-start-1 lg:row-start-1 lg:text-[2.15rem] lg:leading-[1.2]"
          style="color: #ffffff;"
        >
          You Need the Service.
          <span class="block">We Handle Everything Else.</span>
        </h1>

        <div class="animate-slide-right stagger-2 lg:col-start-2 lg:row-start-1 lg:row-span-2">
          <div class="why-hero-mosaic" aria-hidden="true">
            {
              storyImages.map((img, i) => (
                <figure class:list={['why-hero-mosaic__cell', `why-hero-mosaic__cell--${i + 1}`]}>
                  <img
                    src={img.src}
                    alt={img.alt}
                    width="768"
                    height="512"
                    class="h-full w-full object-cover"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </figure>
              ))
            }
          </div>
          <p class="sr-only">
            No searching, negotiating, coordinating, or chasing. Panun Kaergar manages the service
            from booking to completion, with the right professional, clear pricing, and support
            throughout.
          </p>
        </div>

        <div class="lg:col-start-1 lg:row-start-2">
          <p class="animate-fade-up stagger-1 inline-flex max-w-full items-center rounded-full border border-white/25 bg-white/10 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-white/90 backdrop-blur-sm">
            Why choose Panun Kaergar
          </p>
          <p class="animate-fade-up stagger-2 mt-3 max-w-xl text-base leading-relaxed text-white/85 sm:text-lg">
            No searching, negotiating, coordinating, or chasing. Panun Kaergar manages the service
            from booking to completion, with the right professional, clear pricing, and support
            throughout.
          </p>

          <ul class="animate-fade-up stagger-3 mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/80 sm:mt-6 sm:gap-x-6 sm:gap-y-3">
            <li class="flex items-center gap-2">
              <Icon name="check" size={17} class="text-white" />
              The right professional
            </li>
            <li class="flex items-center gap-2">
              <Icon name="check" size={17} class="text-white" />
              Clear pricing
            </li>
            <li class="flex items-center gap-2">
              <Icon name="check" size={17} class="text-white" />
              Support throughout
            </li>
          </ul>

          <div class="animate-fade-up stagger-4 mt-6 flex flex-wrap items-center gap-3">
            <a href={BOOK_PATH} class="btn-primary bg-white text-brand-700 hover:bg-brand-50">
              Book a service
            </a>
            <a
              href={`tel:${site.phone}`}
              class="inline-flex items-center gap-2 rounded-xl border-2 border-white/40 px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 ease-smooth hover:-translate-y-0.5 hover:border-white/60 hover:bg-white/10"
            >
              <Icon name="phone" size={18} />
              Call {site.phone}
            </a>
            <a
              href={customerWhatsAppHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl border-2 border-emerald-300/50 px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 ease-smooth hover:-translate-y-0.5 hover:border-emerald-300/80 hover:bg-emerald-400/15"
            >
              <Icon name="whatsapp" size={18} />
              WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CategoryMarquee categories={categories} />

  <!-- 2. Problem, then solution -->
  <section class="border-y border-slate-200 bg-white" id="the-usual-way" aria-labelledby="solves-heading">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="reveal">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">The usual way — and ours</p>
        <h2 id="solves-heading" class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
          You shouldn’t have to run the job yourself
        </h2>
        <p class="mt-3 max-w-3xl text-lg text-slate-600">
          When you call a plumber, electrician, or cleaner yourself in Kashmir, you hunt for
          numbers, wait on callbacks, negotiate the price, and still own the hassle if nobody
          shows up. Each card is a real problem — then how Panun Kaergar takes it off you.
        </p>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
        {
          problemSolutions.map((row, i) => (
            <article
              class:list={[
                'reveal-scale card card-hover group flex flex-col overflow-hidden p-0',
                `reveal-stagger-${Math.min(i + 1, 6)}`,
              ]}
            >
              <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
                <img
                  src={row.image}
                  alt={row.imageAlt}
                  width="640"
                  height="400"
                  class="h-full w-full object-cover transition-transform duration-500 ease-smooth group-hover:scale-[1.04]"
                  loading="lazy"
                  decoding="async"
                />
                <span class="absolute left-4 top-4 icon-badge !h-10 !w-10 bg-white text-brand-700 shadow-md">
                  <Icon name={row.icon} size={18} />
                </span>
                <div class="pointer-events-none absolute inset-x-0 bottom-0 flex justify-between gap-2 bg-gradient-to-t from-black/70 to-transparent px-3 pb-2.5 pt-8">
                  <span class="rounded-full bg-white/90 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-slate-700">
                    On your own
                  </span>
                  <span class="rounded-full bg-brand-900/90 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white">
                    Panun Kaergar
                  </span>
                </div>
              </div>

              <div class="flex flex-1 flex-col gap-4 p-5">
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">The problem</p>
                  <h3 class="mt-1.5 text-base font-bold leading-snug text-slate-900">{row.problem}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-slate-600">{row.problemDetail}</p>
                </div>

                <div class="mt-auto flex items-start gap-2.5 rounded-xl bg-brand-900 px-3.5 py-3 text-white">
                  <span
                    class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent text-brand-900"
                    aria-hidden="true"
                  >
                    <Icon name="check" size={13} />
                  </span>
                  <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-white/50">Panun Kaergar</p>
                    <p class="mt-0.5 text-sm font-medium leading-relaxed">{row.solution}</p>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <JoinProcessStack
    steps={helpSteps}
    heading="How we help"
    lede="From your request to a quality check — Panun Kaergar manages every step."
    ariaLabel="How we help"
  />

  <!-- 6. Why this matters -->
  <section class="border-y border-slate-200 bg-white" id="why-it-matters">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="reveal">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Why this matters</p>
        <h2 class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
          Home help that stays simple
        </h2>
        <p class="mt-3 max-w-3xl text-lg text-slate-600">
          Booking, the estimate, who comes, payment, and quality — handled by one company, so you
          can get the job done without running it yourself.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          pkFeatures.map((item, i) => (
            <article
              class:list={[
                'reveal-scale card card-hover group flex flex-col overflow-hidden p-0',
                `reveal-stagger-${Math.min(i + 1, 6)}`,
              ]}
            >
              <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
                <img
                  src={item.image}
                  alt={item.imageAlt}
                  width="640"
                  height="400"
                  class="h-full w-full object-cover transition-transform duration-500 ease-smooth group-hover:scale-[1.04]"
                  loading="lazy"
                  decoding="async"
                />
                <span class="absolute left-4 top-4 icon-badge !h-10 !w-10 bg-white text-brand-700 shadow-md">
                  <Icon name={item.icon} size={18} />
                </span>
              </div>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-base font-bold leading-snug text-slate-900">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="bg-slate-50" id="faqs" aria-labelledby="why-choose-faqs-heading">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="reveal max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">FAQs</p>
        <h2 id="why-choose-faqs-heading" class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
          Before you book
        </h2>
        <p class="mt-3 text-lg text-slate-600">
          How booking, pricing, the visit, payment, and follow-up work when Panun Kaergar manages
          the service.
        </p>
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start xl:grid-cols-[minmax(0,1fr)_24rem] xl:gap-12">
