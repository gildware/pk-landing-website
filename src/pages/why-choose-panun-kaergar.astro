---
import PageLayout from '@/layouts/PageLayout.astro';
import FaqSection from '@/components/FaqSection.astro';
import BookingOptions from '@/components/BookingOptions.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Icon from '@/components/Icon.astro';
import { buildMeta } from '@/utils/seo';
import { getSiteSettings, getServices, getAreas } from '@/utils/reader';
import { breadcrumbSchema, faqSchema } from '@/utils/schema';
import { BOOK_PATH } from '@/utils/booking';
import { areaPath } from '@/utils/areaPaths';

const site = await getSiteSettings();
const services = await getServices();
const areas = await getAreas();

const PAGE_PATH = '/why-choose-panun-kaergar';

const meta = buildMeta({
  title: 'Why Choose Panun Kaergar | Home Services Kashmir',
  description:
    'Why choose Panun Kaergar for home services in Kashmir? You hire us — we own booking, pricing, coordination, quality, and support. Work is done by our teams and professional partners.',
  path: PAGE_PATH,
});

const whyChoosePillars = [
  {
    icon: 'shield-check',
    title: 'Verified professionals',
    description:
      'Own crews and specialists are checked before they enter a Kashmir home.',
  },
  {
    icon: 'target',
    title: 'Transparent pricing',
    description:
      'You know the expected cost before tools come out. Extra materials are explained first.',
  },
  {
    icon: 'smartphone',
    title: 'Easy booking',
    description:
      'Phone, WhatsApp, website, or app. Describe the job once.',
  },
  {
    icon: 'clock',
    title: 'Convenient timings',
    description:
      'Pick morning, afternoon, or evening — around how your house actually runs.',
  },
  {
    icon: 'home',
    title: 'No technician hunting',
    description:
      'No neighbour lists, no unanswered calls. We find who goes.',
  },
  {
    icon: 'check',
    title: 'Panun handles the hassle',
    description:
      'Schedule, price, who does the work, and follow-up stay with us.',
  },
  {
    icon: 'message',
    title: 'Support when things go wrong',
    description:
      'No-show or a leak that returns — you call Srinagar support, not a private number.',
  },
  {
    icon: 'star',
    title: 'Easy rebooking',
    description:
      'Same job next season? Open the app or one saved number.',
  },
  {
    icon: 'phone',
    title: 'One number. Every service.',
    description:
      'Trades, cleaning, salon, appliances — one company for the house.',
  },
  {
    icon: 'star-badge',
    title: 'Service you can rely on',
    description:
      'If the work doesn’t hold, the follow-up is ours.',
  },
];

const verificationSteps = [
  {
    title: 'We take the request',
    description:
      'You tell us the job, area, and preferred time. From that moment the customer relationship is ours — not a technician’s private lead.',
  },
  {
    title: 'We assign the right hands',
    description:
      'Depending on the job, we send our own service team, a commission-based vendor, or a specialist partner. They work to Panun Kaergar’s requirements.',
  },
  {
    title: 'They work to our standards',
    description:
      'Whoever arrives is expected to come prepared, respect your home, communicate delays, and follow our quality guidelines.',
  },
  {
    title: 'We stay responsible after the visit',
    description:
      'Ratings, completion, and support tickets feed into how we manage teams and partners. If the work is not right, you come back to Panun Kaergar.',
  },
];

const pricingPoints = [
  {
    title: 'Estimates before work starts',
    description:
      'For most jobs, you receive a price estimate or rate guidance when you book or when we confirm the visit. Complex work may need an on-site inspection first — that is explained upfront.',
  },
  {
    title: 'No hidden booking fee for customers',
    description:
      'Panun Kaergar does not add a separate “booking fee” on top of the service charge for standard home-service requests. You pay for the work we agreed.',
  },
  {
    title: 'Clear breakdown when materials are involved',
    description:
      'If parts, consumables, or extra labour are needed, that additional cost should be explained before proceeding — not after the job is finished.',
  },
  {
    title: 'Written record in the app',
    description:
      'App bookings keep a history of your requests, who was assigned, and job status. That record helps if you need to follow up or book the same service again.',
  },
];

const qualityStandards = [
  {
    icon: 'check',
    title: 'Arrive prepared',
    description: 'Whoever we send is expected to bring the right tools and materials for the job they accepted.',
  },
  {
    icon: 'clock',
    title: 'Respect your time',
    description: 'Confirmed appointment windows should be honoured. Delays are communicated to you and to our support team when possible.',
  },
  {
    icon: 'home',
    title: 'Care for your home',
    description: 'Work areas should be left tidy. Your home is treated with the same care we would expect in our own.',
  },
  {
    icon: 'shield-check',
    title: 'Honest recommendations',
    description: 'If a repair is not worth doing or a cheaper fix exists, that should be said — not used to push unnecessary work.',
  },
];

const bookingSteps = [
  {
    n: '01',
    title: 'Tell us what you need',
    desc: 'Share the service type, your area in Kashmir, and a preferred date or time. Use phone, WhatsApp, the booking form, or the Panun Kaergar app.',
  },
  {
    n: '02',
    title: 'We take care of the rest',
    desc: 'We confirm the visit window and expected cost, then assign our team or a professional partner. You can ask questions before anyone comes to your door.',
  },
  {
    n: '03',
    title: 'We get the work done',
    desc: 'Someone arrives prepared and completes the job to Panun Kaergar’s standards — not as a freelancer you hired on your own.',
  },
  {
    n: '04',
    title: 'We stand behind it',
    desc: 'After the job, you can rate the experience. If anything was unsatisfactory, contact us and we will resolve it.',
  },
];

const supportChannels = [
  {
    icon: 'phone',
    title: 'Phone support',
    description: `Call ${site.phone} during business hours for booking help, reschedules, or urgent questions about an active job.`,
  },
  {
    icon: 'whatsapp',
    title: 'WhatsApp',
    description:
      'Message us on WhatsApp with your service need, area, and photos if relevant. Most customers get a reply within minutes during support hours.',
  },
  {
    icon: 'mail',
    title: 'Email',
    description: `Write to ${site.email} for non-urgent queries, feedback, or documentation you need after a completed service.`,
  },
  {
    icon: 'smartphone',
    title: 'In-app help',
    description:
      'App users can track booking status, see who was assigned, and reach support without searching for a phone number.',
  },
];

const comparisonRows = [
  {
    aspect: 'Finding a service provider',
    traditional:
      'Ask neighbours, search social media groups, or call numbers saved from past jobs — often trial and error.',
    panun:
      'One request to Panun Kaergar. We take the job — pricing, coordination, and who does the work.',
  },
  {
    aspect: 'Knowing if someone is trustworthy',
    traditional:
      'Relies on word of mouth. No standard check unless you verify yourself.',
    panun:
      'You hired Panun Kaergar. We assign our team or a professional partner who works to our standards.',
  },
  {
    aspect: 'Price clarity',
    traditional:
      'Often discussed only on arrival. Extra charges may appear after work starts.',
    panun:
      'Estimate or rate confirmed by Panun Kaergar before the visit. Material and labour additions should be explained upfront.',
  },
  {
    aspect: 'Booking channels',
    traditional:
      'Usually a single phone call. No central record if the person does not answer.',
    panun:
      'Phone, WhatsApp, website form, and mobile app — all tied to Panun Kaergar, not a private worker’s number.',
  },
  {
    aspect: 'If something goes wrong',
    traditional:
      'You resolve it directly with the worker. No company to escalate to.',
    panun:
      'Panun Kaergar owns the complaint, reschedule, and follow-up. Repeat quality issues are our problem to fix.',
  },
  {
    aspect: 'Repeat bookings',
    traditional:
      'You find and save the contact again. Availability is uncertain.',
    panun:
      'Rebook the same category through one familiar process — you are booking us again, not hunting a saved number.',
  },
  {
    aspect: 'Service coverage',
    traditional:
      'Limited to whoever you already know in your circle.',
    panun: `${services.length}+ service categories across ${areas.length} districts and neighbourhoods in Kashmir.`,
  },
];

const pageFaqs = [
  {
    question: 'Why should I choose Panun Kaergar over calling a local technician directly?',
    answer:
      'With a direct call, you hire that person. With Panun Kaergar, you hire us. We own pricing, coordination, quality, and support. The work may be done by our team or a professional partner — you still deal with Panun Kaergar if anything goes wrong.',
  },
  {
    question: 'Who actually does the work?',
    answer:
      'Depending on the job, Panun Kaergar sends its own service team, a commission-based vendor, or a specialist partner. They perform the service to our requirements. You booked the company, not a freelancer’s private listing.',
  },
  {
    question: 'Is pricing transparent on Panun Kaergar?',
    answer:
      'Yes. For most services we confirm an estimate or rate range before the visit. If extra materials or labour are needed, that should be explained and agreed before work continues. App bookings also keep a record of your request.',
  },
  {
    question: 'How does booking work?',
    answer:
      'Tell us the service, your area, and preferred time via phone, WhatsApp, the website booking form, or the Panun Kaergar app. We confirm the visit and expected cost, assign who will do the work, and stand behind the job.',
  },
  {
    question: 'Can I trust Panun Kaergar with my home?',
    answer:
      'Panun Kaergar is built for Kashmir households by a local technology team. Jobs are tracked, quality is our responsibility, and our Srinagar support line is available when you need help. Thousands of homes across Srinagar and nearby districts already book with us.',
  },
  {
    question: 'What areas in Kashmir does Panun Kaergar cover?',
    answer: `We serve homes across Kashmir including ${areas
      .slice(0, 5)
      .map((a) => a.displayName)
      .join(', ')}, and more. Check our service areas page for your district, or mention your neighbourhood when you book.`,
  },
  {
    question: 'What if I am not satisfied with the service?',
    answer:
      'Contact our support team by phone or WhatsApp with your booking details. Panun Kaergar reviews the complaint and works toward a fair resolution — which may include a revisit, partial adjustment, or follow-up depending on the situation.',
  },
  {
    question: 'Do I need the app to book?',
    answer:
      'No. You can book by calling, WhatsApp, or the website form. The free Panun Kaergar app is optional but useful for tracking status, viewing history, and rebooking quickly.',
  },
];

const schemas = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Why Choose Panun Kaergar', path: PAGE_PATH },
  ]),
  faqSchema(pageFaqs),
].filter(Boolean);
---

<PageLayout meta={meta} schemas={schemas}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-brand-900 text-white">
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-br from-brand-900 via-brand-700 to-brand-600"
      aria-hidden="true"
    ></div>
    <div class="hero-blob -left-24 top-0 h-72 w-72 bg-brand-500/30" style="animation-delay: 0s;" aria-hidden="true"></div>
    <div class="hero-blob -right-16 bottom-0 h-96 w-96 bg-accent/20" style="animation-delay: -5s;" aria-hidden="true"></div>

    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 sm:px-6 lg:grid-cols-2 lg:py-20">
      <div>
        <p class="animate-fade-up text-sm font-semibold uppercase tracking-[0.2em] text-accent">
          Why choose us
        </p>
        <h1 class="animate-fade-up stagger-1 mt-3 font-extrabold leading-[1.08] tracking-tight text-white text-[clamp(2rem,5.5vw,3.5rem)]">
          Trusted home help — without the hunt
        </h1>
        <p class="animate-fade-up stagger-2 mt-5 max-w-xl text-lg leading-relaxed text-white/85">
          Don’t collect numbers. Book one company for plumbing, electrical, cleaning, salon,
          appliances, and the rest of the house.
        </p>
        <div class="animate-fade-up stagger-3 mt-8 flex flex-wrap gap-3">
          <a href={BOOK_PATH} class="btn-primary bg-white text-brand-700 hover:bg-brand-50">Book a service</a>
          <a href="/services" class="btn-secondary border-white/25 bg-white/10 text-white hover:border-white/40 hover:bg-white/15">
            Browse services
          </a>
        </div>
      </div>

      <div class="animate-slide-right stagger-2 relative hidden overflow-hidden rounded-3xl border border-white/15 shadow-2xl lg:block">
        <img
          src="/images/why-choose/why-choose-hero.webp"
          alt="Trusted home services in Kashmir — a Panun Kaergar professional with a happy family after a household repair"
          width="1920"
          height="1280"
          class="aspect-[16/10] w-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <div class="border-b border-slate-200 bg-white">
    <nav class="page-breadcrumb mx-auto max-w-6xl px-4 py-4 sm:px-6" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Why Choose Panun Kaergar</span>
    </nav>
  </div>

  <!-- Why Choose overview -->
  <section class="border-b border-slate-200 bg-white" id="why-choose">
    <div class="section-pad mx-auto max-w-6xl">
      <div class="reveal mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Why choose Panun Kaergar?</p>
        <h2 class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
          What you get when you book Panun Kaergar
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">
          Finding a plumber, electrician, or cleaner in Srinagar often means calling several numbers,
          waiting for callbacks, and hoping the person who shows up is skilled and fair. Panun Kaergar
          replaces that uncertainty with a company that takes the job: we confirm pricing, assign who
          does the work, and you can reach us if anything goes wrong.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          whyChoosePillars.map((item, i) => (
            <article
              class:list={[
                'reveal-scale card card-hover p-6 sm:p-7',
                `reveal-stagger-${Math.min(i + 1, 6)}`,
              ]}
            >
              <span class="icon-badge">
                <Icon name={item.icon} size={22} class="text-brand-600" />
              </span>
              <h3 class="mt-4 text-lg font-bold text-slate-900">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Trusted & verified -->
  <section class="bg-slate-50" id="verified-providers">
    <div class="section-pad mx-auto max-w-6xl">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="reveal-left overflow-hidden rounded-3xl border border-slate-200 shadow-xl">
          <img
            src="/images/why-choose/why-choose-verified.webp"
            alt="Panun Kaergar professional introducing themselves to a homeowner in Kashmir before a home visit"
            width="1920"
            height="1280"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="reveal">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">
            How we get the work done
          </p>
          <h2 class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
            You hired Panun Kaergar — we decide who does the work
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-slate-600">
            “Leave it to us” means the customer relationship stays with Panun Kaergar. The person
            at your door may be our own team, a commission-based vendor, or a specialist partner —
            they work to our requirements. That matters when you are letting someone into your home.
          </p>

          <ol class="mt-8 space-y-5">
            {
              verificationSteps.map((step, i) => (
                <li
                  class:list={[
                    'reveal border-l-2 border-brand-600 pl-4',
                    `reveal-stagger-${Math.min(i + 1, 6)}`,
                  ]}
                >
                  <h3 class="font-bold text-slate-900">{step.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-slate-600 sm:text-base">
                    {step.description}
                  </p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- Transparent pricing -->
  <section class="border-y border-slate-200 bg-white" id="transparent-pricing">
    <div class="section-pad mx-auto max-w-6xl">
      <div class="grid items-start gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
        <div class="reveal">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Transparent pricing</p>
          <h2 class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
            Know what to expect before work begins
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-slate-600">
            Unclear pricing is one of the biggest frustrations with home services. Panun Kaergar is
            designed so you understand the expected cost early — not after a job is half finished.
          </p>
          <p class="mt-4 text-base leading-relaxed text-slate-600">
            Exact amounts depend on the service: a fixed-rate salon visit differs from a plumbing
            repair that needs parts. In every case, the goal is the same — no surprises on your bill.
          </p>
        </div>

        <ul class="reveal-right space-y-4">
          {
            pricingPoints.map((point, i) => (
              <li
                class:list={[
                  'reveal rounded-2xl border border-slate-200 bg-slate-50/80 p-5 sm:p-6',
                  `reveal-stagger-${Math.min(i + 1, 6)}`,
                ]}
              >
                <h3 class="font-bold text-slate-900">{point.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{point.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Quality standards -->
  <section class="bg-gradient-to-b from-slate-50 to-white" id="quality-standards">
    <div class="section-pad mx-auto max-w-6xl">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Quality standards</p>
        <h2 class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
          What we expect from every visit
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">
          These standards define how every visit should go — and give you a clear basis to rate
          or report if they do not.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          qualityStandards.map((item, i) => (
            <article
              class:list={[
                'reveal-scale rounded-3xl border border-slate-200 bg-white p-6 shadow-sm',
                `reveal-stagger-${Math.min(i + 1, 6)}`,
              ]}
            >
              <span class="icon-badge">
                <Icon name={item.icon} size={22} class="text-brand-600" />
              </span>
              <h3 class="mt-4 text-base font-bold text-slate-900">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Easy booking -->
  <section class="border-y border-slate-200 bg-white" id="booking-process">
    <div class="section-pad mx-auto max-w-6xl">
      <div class="grid items-center gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
        <div class="reveal-left overflow-hidden rounded-3xl border border-slate-200 shadow-xl">
          <img
            src="/images/why-choose/why-choose-booking.webp"
            alt="Booking a home service on smartphone in Kashmir while a Panun Kaergar professional arrives at the door"
            width="1920"
            height="1280"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="reveal">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Easy booking process</p>
          <h2 class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
            From request to completed job in four steps
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-slate-600">
            You do not need to understand how we assign the work behind the scenes. Describe what you
            need — we handle pricing, who does the job, confirmation, and follow-up.
          </p>

          <ol class="mt-8 space-y-4">
            {
              bookingSteps.map((step, i) => (
                <li
                  class:list={[
                    'reveal flex gap-4 rounded-2xl border border-slate-200 bg-slate-50/80 p-4 sm:p-5',
                    `reveal-stagger-${Math.min(i + 1, 6)}`,
                  ]}
                >
                  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
                    {step.n}
                  </span>
                  <div>
                    <h3 class="text-lg font-bold text-slate-900">{step.title}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-slate-600">{step.desc}</p>
                  </div>
                </li>
              ))
            }
          </ol>

          <div class="reveal mt-8">
            <a href={BOOK_PATH} class="btn-primary">
              Start a booking
              <Icon name="chevron-right" size={18} class="ml-1 inline" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Customer support -->
  <section class="bg-brand-900 text-white" id="customer-support">
    <div class="section-pad mx-auto max-w-6xl">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Customer support</p>
        <h2 class="mt-2 text-3xl font-extrabold sm:text-4xl">A real team behind every booking</h2>
        <p class="mt-4 text-lg leading-relaxed text-white/85">
          Panun Kaergar is not a listing site. When you book with us, you have a company behind
          the job — for reschedules, questions, and complaints — not just a worker’s private phone
          number.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          supportChannels.map((channel, i) => (
            <article
              class:list={[
                'reveal-scale rounded-2xl border border-white/15 bg-white/10 p-6 backdrop-blur-sm',
                `reveal-stagger-${Math.min(i + 1, 6)}`,
              ]}
            >
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-white/15">
                <Icon name={channel.icon} size={22} class="text-accent" />
              </span>
              <h3 class="mt-4 text-base font-bold">{channel.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/80">{channel.description}</p>
            </article>
          ))
        }
      </div>

      <p class="reveal mt-10 text-center text-sm text-white/70">
        Office hours: Monday–Saturday, 10:00–18:00 · Call centre support: daily 10:00–22:00
      </p>
    </div>
  </section>

  <!-- Local expertise -->
  <section class="border-b border-slate-200 bg-white" id="local-expertise">
    <div class="section-pad mx-auto max-w-6xl">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="reveal order-2 lg:order-1">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">
            Local expertise in Kashmir
          </p>
          <h2 class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
            Partners who know how homes work here
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-slate-600">
            Kashmir’s climate, building styles, and neighbourhood layouts are different from other
            cities. A company built here understands that geysers fail differently in winter, that
            drainage issues vary by area, and that customers in Rajbagh and Bemina expect people who
            know the locality.
          </p>
          <p class="mt-4 text-base leading-relaxed text-slate-600">
            Panun Kaergar assigns jobs by district and neighbourhood so whoever we send can
            realistically reach your home — not someone based hours away.
