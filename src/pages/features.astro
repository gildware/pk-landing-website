---
import PageLayout from '@/layouts/PageLayout.astro';
import CategoryMarquee from '@/components/CategoryMarquee.astro';
import FaqSection from '@/components/FaqSection.astro';
import BookingOptions from '@/components/BookingOptions.astro';
import AskQuestionForm from '@/components/AskQuestionForm.astro';
import Icon from '@/components/Icon.astro';
import { buildMeta, truncate } from '@/utils/seo';
import { getSiteSettings, getServices, getAreas, siteUrl } from '@/utils/reader';
import {
  breadcrumbSchema,
  faqSchema,
  itemListSchema,
  mobileApplicationsSchema,
} from '@/utils/schema';
import { BOOK_PATH, whatsappHref } from '@/utils/booking';

const site = await getSiteSettings();
const services = await getServices();
const areas = await getAreas();
const customerWhatsAppHref = whatsappHref(
  site.whatsapp,
  'Hello Panun Kaergar, I would like to book a home service.',
);

const categories = services.map((s) => ({
  slug: s.slug,
  shortName: s.shortName,
}));

const PAGE_PATH = '/features';

const meta = buildMeta({
  title: 'How to Book and Track Home Services | Panun Kaergar',
  description: truncate(
    'Use Panun Kaergar your way — call, WhatsApp, website, or the app. Track bookings, request custom jobs, and earn loyalty points. The app is optional.',
  ),
  path: PAGE_PATH,
  ogImage: '/images/features/features-hero.webp',
  ogImageAlt:
    'A Kashmir household booking a home service with Panun Kaergar by phone and app',
  ogImageWidth: 1920,
  ogImageHeight: 1280,
});

const storyImages = [
  {
    src: '/images/features/features-booking.webp',
    alt: 'Booking a home service by phone, WhatsApp, or website',
  },
  {
    src: '/images/features/features-app.webp',
    alt: 'Following a Panun Kaergar booking in the customer app',
  },
  {
    src: '/images/features/features-custom-jobs.webp',
    alt: 'Describing a custom home job that is not on the standard list',
  },
  {
    src: '/images/features/features-hero.webp',
    alt: 'A Kashmir household booking home help with Panun Kaergar',
  },
];

const bookingChannels = [
  {
    icon: 'phone',
    title: 'Call',
    description: `Dial ${site.phone} and tell us the job, your area, and a preferred time. We create the booking and take it from there.`,
  },
  {
    icon: 'whatsapp',
    title: 'WhatsApp',
    description:
      'Send the service, neighbourhood, and preferred time. Photos help for repairs. We reply and confirm the visit.',
  },
  {
    icon: 'form',
    title: 'Website',
    description:
      'Fill the booking form from any browser. Useful if you are on a laptop or do not want another app.',
  },
  {
    icon: 'smartphone',
    title: 'Customer app',
    description:
      'Book on Android or iOS, then track status, chat on that job, rebook from history, and earn loyalty points.',
  },
];

const appExtras = [
  {
    icon: 'target',
    title: 'Track the booking',
    description: 'See request status and visit windows in one place, instead of calling around for an update.',
  },
  {
    icon: 'message',
    title: 'Chat on that job',
    description: 'Ask about timing, reschedules, or details before the visit. The conversation stays linked to your booking.',
  },
  {
    icon: 'clock',
    title: 'History and rebook',
    description: 'Open a past visit and book again — same service, less repeating yourself.',
  },
  {
    icon: 'star',
    title: 'Rate the visit',
    description: 'Leave a rating after the job. Feedback helps us stand behind the work.',
  },
];

const afterYouBook = [
  {
    icon: 'smartphone',
    title: 'If you booked in the app',
    description: 'Open the booking to see status and message support on that job.',
  },
  {
    icon: 'headset',
    title: 'If you booked by call or WhatsApp',
    description: 'We confirm the visit and update you on timing. You can always call or message us with the booking details.',
  },
];

const customJobSteps = [
  {
    n: '01',
    title: 'Describe the work',
    desc: 'Tell us what you need, your area, and any photos or constraints — app, WhatsApp, or call.',
  },
  {
    n: '02',
    title: 'We scope it and confirm the price',
    desc: 'We review the request and confirm an estimate before work begins.',
  },
  {
    n: '03',
    title: 'We confirm the visit',
    desc: 'The job is booked like any other Panun Kaergar service. You can follow it the same way.',
  },
];

const pageFaqs = [
  {
    question: 'Do I need the Panun Kaergar app to book a home service in Kashmir?',
    answer:
      'No. You can book by phone, WhatsApp, or the website form. The free customer app adds tracking, chat on that job, history, rebooking, custom-job requests, and loyalty points — but it is optional.',
  },
  {
    question: 'If I book by phone or WhatsApp, is it the same service as booking in the app?',
    answer:
      'Yes. Every channel is a request to Panun Kaergar. We manage pricing, who comes, the visit, payment, and support. The app is a convenient way to follow the job — not a different company.',
  },
  {
    question: 'What can I do in the Panun Kaergar customer app that I cannot do on a call?',
    answer:
      'The app lets you browse services, book and rebook from your history, track status, chat on a specific job, request a custom job, rate a visit, and earn loyalty points on completed app bookings.',
  },
  {
    question: 'How do I know what is happening after I send a request?',
    answer:
      'App bookings show status in the app. For phone or WhatsApp bookings, we confirm the visit and can update you on timing. Either way, you come back to Panun Kaergar if you need help.',
  },
  {
    question: 'What if the job I need is not in the service list?',
    answer:
      'Describe the work — in the app, on WhatsApp, or on a call — with your area and any photos. We scope it, confirm an estimate, and book the visit like any other job.',
  },
  {
    question: 'How do Panun Kaergar loyalty rewards work?',
    answer:
      'Completed bookings made through the customer app earn points. You can redeem those points for money off a future home service booked in the app.',
  },
  {
    question: 'Is there a separate app for service partners?',
    answer:
      'Yes. The Partner app is for professionals who fulfill Panun Kaergar jobs. Customers use the customer app, or book by phone, WhatsApp, or website. See Become a partner if you want to join the network.',
  },
  {
    question: 'Which areas in Kashmir can I book from?',
    answer: `Homes across Kashmir including ${areas
      .slice(0, 5)
      .map((a) => a.displayName)
      .join(', ')}, and more. Mention your neighbourhood when you book.`,
  },
];

const schemaFeatures = [
  ...bookingChannels.map((c) => ({
    name: c.title,
    url: siteUrl(`${PAGE_PATH}#booking-channels`),
    description: c.description,
  })),
  ...appExtras.map((c) => ({
    name: c.title,
    url: siteUrl(`${PAGE_PATH}#app-features`),
    description: c.description,
  })),
];

const schemas = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Features', path: PAGE_PATH },
  ]),
  faqSchema(pageFaqs),
  itemListSchema(schemaFeatures, 'Panun Kaergar features'),
  ...mobileApplicationsSchema(site),
].filter(Boolean);
---

<PageLayout meta={meta} schemas={schemas}>
  <section
    class="relative overflow-hidden bg-brand-900 bg-gradient-to-br from-brand-900 via-brand-600 to-brand-700 text-white"
    style="background-color: #121228; color: #ffffff;"
  >
    <div class="hero-blob -left-24 top-0 h-72 w-72 bg-brand-500/30" style="animation-delay: 0s;" aria-hidden="true"></div>
    <div class="hero-blob -right-16 bottom-0 h-96 w-96 bg-accent/20" style="animation-delay: -5s;" aria-hidden="true"></div>
    <div class="hero-blob left-1/3 top-1/2 h-48 w-48 bg-white/10" style="animation-delay: -9s;" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-9 lg:py-14">
      <div class="flex flex-col gap-5 lg:grid lg:grid-cols-2 lg:items-start lg:gap-12">
        <h1
          class="animate-fade-up text-[1.35rem] font-extrabold leading-snug text-white sm:text-[1.75rem] lg:col-start-1 lg:row-start-1 lg:text-[2.15rem] lg:leading-[1.2]"
          style="color: #ffffff;"
        >
          Use Panun Kaergar your way.
          <span class="block">We still handle the job.</span>
        </h1>

        <div class="animate-slide-right stagger-2 lg:col-start-2 lg:row-start-1 lg:row-span-2">
          <div class="features-hero-mosaic" aria-hidden="true">
            {
              storyImages.map((img, i) => (
                <figure class:list={['features-hero-mosaic__cell', `features-hero-mosaic__cell--${i + 1}`]}>
                  <img
                    src={img.src}
                    alt={img.alt}
                    width="768"
                    height="512"
                    class="h-full w-full object-cover"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </figure>
              ))
            }
          </div>
          <p class="sr-only">
            Book by call, WhatsApp, website, or the Panun Kaergar app. The company manages the
            service either way. The app is optional.
          </p>
        </div>

        <div class="lg:col-start-1 lg:row-start-2">
          <p class="animate-fade-up stagger-1 inline-flex max-w-full items-center rounded-full border border-white/25 bg-white/10 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-white/90 backdrop-blur-sm">
            How you book and follow a job
          </p>
          <p class="animate-fade-up stagger-2 mt-3 max-w-xl text-base leading-relaxed text-white/85 sm:text-lg">
            Call, WhatsApp, website, or the app — same company, same managed service. The app adds
            tracking, chat, custom jobs, and loyalty. You do not need it to book.
          </p>

          <ul class="animate-fade-up stagger-3 mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/80 sm:mt-6 sm:gap-x-6 sm:gap-y-3">
            <li class="flex items-center gap-2">
              <Icon name="check" size={17} class="text-white" />
              Four ways to book
            </li>
            <li class="flex items-center gap-2">
              <Icon name="check" size={17} class="text-white" />
              Track in the app if you want
            </li>
            <li class="flex items-center gap-2">
              <Icon name="check" size={17} class="text-white" />
              Custom jobs and loyalty
            </li>
          </ul>

          <div class="animate-fade-up stagger-4 mt-6 flex flex-wrap items-center gap-3">
            <a href={BOOK_PATH} class="btn-primary bg-white text-brand-700 hover:bg-brand-50">
              Book a service
            </a>
            <a
              href="/download"
              class="inline-flex items-center gap-2 rounded-xl border-2 border-white/40 px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 ease-smooth hover:-translate-y-0.5 hover:border-white/60 hover:bg-white/10"
            >
              Download the app
            </a>
            <a
              href={`tel:${site.phone}`}
              class="inline-flex items-center gap-2 rounded-xl border-2 border-white/40 px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 ease-smooth hover:-translate-y-0.5 hover:border-white/60 hover:bg-white/10"
            >
              <Icon name="phone" size={18} />
              Call {site.phone}
            </a>
            <a
              href={customerWhatsAppHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl border-2 border-emerald-300/50 px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 ease-smooth hover:-translate-y-0.5 hover:border-emerald-300/80 hover:bg-emerald-400/15"
            >
              <Icon name="whatsapp" size={18} />
              WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CategoryMarquee categories={categories} />

  <!-- Four ways to book -->
  <section class="border-y border-slate-200 bg-white" id="booking-channels" aria-labelledby="booking-channels-heading">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="reveal">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Book your way</p>
        <h2 id="booking-channels-heading" class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
          Four ways to request a home service
        </h2>
        <p class="mt-3 max-w-3xl text-lg text-slate-600">
          Every channel is a request to Panun Kaergar. We manage the job from there.
        </p>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          bookingChannels.map((item, i) => (
            <article
              class:list={[
                'reveal-scale card card-hover p-5 sm:p-6',
                `reveal-stagger-${Math.min(i + 1, 6)}`,
              ]}
            >
              <span class="icon-badge">
                <Icon name={item.icon} size={22} class="text-brand-600" />
              </span>
              <h3 class="mt-4 text-base font-bold leading-snug text-slate-900">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What the app adds -->
  <section class="bg-slate-50" id="app-features" aria-labelledby="app-features-heading">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
        <div class="reveal">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Customer app</p>
          <h2 id="app-features-heading" class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
            What the app adds — if you want it
          </h2>
          <p class="mt-3 text-lg text-slate-600">
            You can skip the app entirely. If you install it, you get a clearer view of the booking
            you already made with Panun Kaergar.
          </p>

          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {
              appExtras.map((item, i) => (
                <article
                  class:list={[
                    'reveal-scale rounded-2xl border border-slate-200 bg-white p-4 sm:p-5',
                    `reveal-stagger-${Math.min(i + 1, 6)}`,
                  ]}
                >
                  <span class="icon-badge !h-9 !w-9">
                    <Icon name={item.icon} size={18} class="text-brand-600" />
                  </span>
                  <h3 class="mt-3 text-sm font-bold text-slate-900">{item.title}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{item.description}</p>
                </article>
              ))
            }
          </div>

          <div class="reveal mt-8">
            <a href="/download" class="btn-primary">
              Download the app
              <Icon name="chevron-right" size={18} class="ml-1 inline" />
            </a>
          </div>
        </div>

        <div class="reveal overflow-hidden rounded-[1.75rem] border border-slate-200 shadow-xl">
          <img
            src="/images/features/features-app.webp"
            alt="Following a Panun Kaergar booking in the customer app"
            width="1920"
            height="1280"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- After you book -->
  <section class="border-y border-slate-200 bg-white" id="after-you-book" aria-labelledby="after-heading">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="reveal">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">After you book</p>
        <h2 id="after-heading" class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
          How you know what happens next
        </h2>
        <p class="mt-3 max-w-3xl text-lg text-slate-600">
          Same company either way. The channel only changes how updates reach you.
        </p>
      </div>

      <div class="reveal mt-10 grid gap-6 lg:grid-cols-2">
        <article class="overflow-hidden rounded-[1.75rem] bg-accent p-6 text-brand-900 shadow-xl sm:p-8">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-900 text-white">
            <Icon name={afterYouBook[0].icon} size={20} />
          </span>
          <h3 class="mt-5 text-xl font-extrabold">{afterYouBook[0].title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-brand-900/75 sm:text-base">{afterYouBook[0].description}</p>
        </article>
        <article class="overflow-hidden rounded-[1.75rem] bg-brand-900 p-6 text-white shadow-xl sm:p-8">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-white/10">
            <Icon name={afterYouBook[1].icon} size={20} />
          </span>
          <h3 class="mt-5 text-xl font-extrabold">{afterYouBook[1].title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/75 sm:text-base">{afterYouBook[1].description}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Custom jobs -->
  <section class="bg-slate-50" id="custom-jobs" aria-labelledby="custom-jobs-heading">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
        <div class="reveal">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Custom jobs</p>
          <h2 id="custom-jobs-heading" class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
            When the job is not on the list
          </h2>
          <p class="mt-3 text-lg text-slate-600">
            Describe what you need. We scope it, confirm an estimate, and book it like any other
            Panun Kaergar visit.
          </p>

          <ol class="mt-8 space-y-3">
            {
              customJobSteps.map((step, i) => (
                <li
                  class:list={[
                    'reveal flex gap-4 rounded-2xl border border-slate-200 bg-white p-4 sm:p-5',
                    `reveal-stagger-${Math.min(i + 1, 6)}`,
                  ]}
                >
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-900 text-sm font-bold text-white">
                    {step.n}
                  </span>
                  <div>
                    <h3 class="font-bold text-slate-900">{step.title}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-slate-600">{step.desc}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="reveal overflow-hidden rounded-[1.75rem] border border-slate-200 shadow-xl">
          <img
            src="/images/features/features-custom-jobs.webp"
            alt="Describing a custom home job for Panun Kaergar to scope and book"
            width="1920"
            height="1280"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Loyalty -->
  <section class="border-y border-slate-200 bg-white" id="loyalty" aria-labelledby="loyalty-heading">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="reveal overflow-hidden rounded-[1.75rem] bg-brand-900 text-white shadow-xl">
        <div class="grid lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
          <div class="px-5 py-8 sm:px-8 lg:px-10 lg:py-12">
            <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/45">Loyalty</p>
            <h2 id="loyalty-heading" class="mt-3 text-3xl font-extrabold leading-tight sm:text-4xl">
              Points on completed app bookings
            </h2>
            <p class="mt-4 max-w-xl text-lg leading-relaxed text-white/80">
              Finish a job you booked in the customer app and you earn points. Redeem them for money
              off a future home service booked in the app.
            </p>
            <div class="mt-8">
              <a href="/download" class="btn-primary bg-white text-brand-700 hover:bg-brand-50">
                Get the app
              </a>
            </div>
          </div>
          <div class="hidden h-full min-h-[16rem] lg:block">
            <img
              src="/images/features/features-hero.webp"
              alt="Booking again with Panun Kaergar from the customer app"
              width="960"
              height="720"
              class="h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why choose us teaser -->
  <section class="bg-slate-50" aria-labelledby="why-teaser-heading">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="reveal overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-xl">
        <div class="grid lg:grid-cols-2">
          <div class="bg-accent px-5 py-8 text-brand-900 sm:px-8 lg:px-10 lg:py-10">
            <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-brand-900/50">Why choose us</p>
            <h2 id="why-teaser-heading" class="mt-3 text-2xl font-extrabold leading-tight sm:text-3xl">
              Features are how you book. Why choose us is why it is easier.
            </h2>
            <p class="mt-4 max-w-lg text-base leading-relaxed text-brand-900/80">
              Pricing, who comes, coordination, payment, and support stay with Panun Kaergar — so you
              are not chasing a private number.
            </p>
            <a
              href="/why-choose-panun-kaergar"
              class="mt-6 inline-flex items-center gap-1 text-sm font-bold text-brand-900 underline-offset-4 hover:underline"
            >
              See why households book us
              <Icon name="chevron-right" size={16} />
            </a>
          </div>
          <div class="bg-brand-900 px-5 py-8 text-white sm:px-8 lg:px-10 lg:py-10">
            <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/45">Partners</p>
            <h3 class="mt-3 text-2xl font-extrabold leading-tight sm:text-3xl">
              A separate Partner app for the people who do the work
            </h3>
            <p class="mt-4 max-w-lg text-base leading-relaxed text-white/75">
              Customers book Panun Kaergar. Professionals who join the network use the Partner app
              for assigned jobs and payout.
            </p>
            <a
              href="/become-a-partner"
              class="mt-6 inline-flex items-center gap-1 text-sm font-bold text-accent underline-offset-4 hover:underline"
            >
              Become a partner
              <Icon name="chevron-right" size={16} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="border-y border-slate-200 bg-white" id="faqs" aria-labelledby="faqs-heading">
    <div class="section-pad mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <div class="reveal max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">FAQs</p>
        <h2 id="faqs-heading" class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
          Booking, the app, and what happens after
        </h2>
        <p class="mt-3 text-lg text-slate-600">
          How channels, tracking, custom jobs, and loyalty work — without needing the app to book.
        </p>
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start xl:grid-cols-[minmax(0,1fr)_24rem] xl:gap-12">
        <div class="min-w-0">
          <FaqSection items={pageFaqs} compact class="!py-0" />
